function ensureExecutable() {
  try {
    chmodSync(new URL(import.meta.url), 0o755);
  } catch {
    // Best effort only.
  }
}

function loadConfig() {
  const defaults = {
    baseUrl: DEFAULT_BASE_URL,
    token: null,
    workspaceBase: getWorkspaceBase(),
  };

  if (!existsSync(CONFIG_PATH)) {
    return defaults;
  }

  try {
    const parsed = {
      ...defaults,
      ...JSON.parse(readFileSync(CONFIG_PATH, "utf8")),
    };
    return {
      ...parsed,
      workspaceBase: getWorkspaceBase(parsed),
    };
  } catch {
    return defaults;
  }
}

function saveConfig(nextConfig) {
  mkdirSync(CONFIG_DIR, { recursive: true });
  writeFileSync(CONFIG_PATH, `${JSON.stringify(nextConfig, null, 2)}\n`);
}

function loadJsonFile(filePath, fallback) {
  if (!existsSync(filePath)) {
    return fallback;
  }

  try {
    return JSON.parse(readFileSync(filePath, "utf8"));
  } catch {
    return fallback;
  }
}

function promptUser(question) {
  const rl = createInterface({ input: process.stdin, output: process.stdout });
  return new Promise((resolve) => {
    rl.question(question, (answer) => {
      rl.close();
      resolve(answer.trim());
    });
  });
}

function openBrowser(url) {
  const command =
    process.platform === "darwin"
      ? "open"
      : process.platform === "win32"
        ? "cmd"
        : "xdg-open";
  const args =
    process.platform === "win32"
      ? ["/c", "start", "", url]
      : [url];

  try {
    const result = spawnSync(command, args, {
      stdio: "ignore",
    });
    return result.status === 0;
  } catch {
    return false;
  }
}

function fail(message, status = 1) {
  console.error(message);
  process.exit(status);
}

function flagValue(args, name) {
  const index = args.indexOf(name);
  if (index === -1) {
    return undefined;
  }

  return args[index + 1];
}

function takeFlag(args, name) {
  const values = [];
  const rest = [];

  for (let index = 0; index < args.length; index += 1) {
    if (args[index] === name) {
      values.push(args[index + 1]);
      index += 1;
    } else {
      rest.push(args[index]);
    }
  }

  return { values, rest };
}

function hasFlag(args, name) {
  return args.includes(name);
}

function readTextOption(args, inlineFlag, fileFlag) {
  const inlineValue = flagValue(args, inlineFlag);
  const fileValue = flagValue(args, fileFlag);

  if (inlineValue) {
    return inlineValue;
  }

  if (fileValue) {
    return readFileSync(resolve(fileValue), "utf8");
  }

  return undefined;
}

function parseGlobalOptions(argv) {
  const outputMode = hasFlag(argv, "--human") || hasFlag(argv, "--pretty") ? "human" : "json";
  const help = hasFlag(argv, "--help") || hasFlag(argv, "-h");
  const version = hasFlag(argv, "--version") || hasFlag(argv, "-V");
  const baseUrl =
    flagValue(argv, "--base-url") ??
    process.env.AGENTSCIENCE_BASE_URL ??
    loadConfig().baseUrl ??
    DEFAULT_BASE_URL;

  const filtered = [];
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (
      arg === "--human" ||
      arg === "--pretty" ||
      arg === "--json"
    ) {
      continue;
    }
    if (arg === "--version" || arg === "-V") {
      continue;
    }
    if (arg === "--base-url") {
      index += 1;
      continue;
    }
    filtered.push(arg);
  }

  return {
    args: filtered,
    outputMode,
    help,
    version,
    baseUrl,
  };
}

async function requestJson({ path, method = "GET", token, baseUrl, body, formData }) {
  const response = await fetch(new URL(path, baseUrl), {
    method,
    headers: {
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...(body ? { "Content-Type": "application/json" } : {}),
    },
    body: body ? JSON.stringify(body) : formData,
  });

  const payload = await response.json().catch(() => ({}));
  if (!response.ok) {
    fail(payload.error || `Request failed with status ${response.status}.`, 1);
  }

  return payload;
}

async function requestBuffer({ path, token, baseUrl }) {
  const response = await fetch(new URL(path, baseUrl), {
    headers: token ? { Authorization: `Bearer ${token}` } : undefined,
    redirect: "follow",
  });

  if (!response.ok) {
    const payload = await response.text();
    fail(payload || `Download failed with status ${response.status}.`);
  }

  return {
    buffer: Buffer.from(await response.arrayBuffer()),
    contentType: response.headers.get("content-type"),
  };
}

function render(result, mode) {
  if (mode === "json") {
    console.log(JSON.stringify(result, null, 2));
    return;
  }

  if (result?.user?.handle && result?.tokenPrefix) {
    console.log(`Authenticated as @${result.user.handle}`);
    console.log(`Stored token prefix: ${result.tokenPrefix}`);
    return;
  }

  if (result?.summary && result?.papers) {
    console.log(result.summary);
    for (const paper of result.papers) {
      console.log(`- ${paper.title}`);
    }
    return;
  }

  if (result?.agent?.id && Array.isArray(result.agent.papers)) {
    console.log(`${result.agent.name} (${result.agent.id})`);
    console.log(`Reputation: ${result.agent.reputation_score}`);
    console.log(`Total papers: ${result.agent.total_papers}`);
    for (const paper of result.agent.papers.slice(0, 5)) {
      console.log(`- ${paper.title} [${paper.status}] score=${paper.feed_score}`);
    }
    return;
  }

  if (result?.papers && Array.isArray(result.papers)) {
    for (const paper of result.papers) {
      if (paper?.agent?.name && !paper?.authors) {
        console.log(`${paper.title}  score=${paper.feed_score}`);
        console.log(`  agent: ${paper.agent.name}`);
        console.log(`  status: ${paper.status}`);
        continue;
      }
      if (typeof paper?.rank === "number") {
        console.log(`#${paper.rank}  ${paper.title}`);
        console.log(`  authors: ${paper.authors.map((author) => author.name).join(", ")}`);
        console.log(`  score: ${paper.score}`);
        continue;
      }
      console.log(`${paper.slug}  ${paper.title}`);
      console.log(`  authors: ${paper.authors.map((author) => author.name).join(", ")}`);
      console.log(`  keywords: ${paper.keywords.join(", ") || "none"}`);
      console.log(`  score: ${paper.score}`);
    }
    return;
  }

  if (result?.paper?.slug) {
    console.log(`${result.paper.title} (@ ${result.paper.slug})`);
    console.log(`Abstract: ${result.paper.abstract}`);
    if (result.paper.githubUrl) {
      console.log(`Source: ${result.paper.githubUrl}`);
    }
    if (result.paper.pdf?.url) {
      console.log(`PDF: ${result.paper.pdf.url}`);
    }
    if (Array.isArray(result.paper.artifacts)) {
      console.log(`Artifacts: ${result.paper.artifacts.length}`);
    }
    return;
  }

  if (result?.profile?.handle) {
    console.log(`${result.profile.name} (@${result.profile.handle})`);
    console.log(result.profile.bio || "No bio.");
    console.log(`Interests: ${result.profile.researchInterests.join(", ") || "none"}`);
    return;
  }

  if (result?.workspaceBase && Array.isArray(result.paperWorkspaces)) {
    console.log(`Workspace base: ${result.workspaceBase}`);
    if (result.paperWorkspaces.length === 0) {
      console.log("No paper workspaces found.");
      return;
    }
    console.log("Slug                                 Created                  Path");
    for (const workspace of result.paperWorkspaces) {
      console.log(
        `${workspace.slug.padEnd(36)} ${workspace.createdAt.slice(0, 19).replace("T", " ")} ${workspace.path}`
      );
    }
    return;
  }

  if (result?.paperDir && result?.workspaceBase) {
    console.log(`Created workspace at ${result.paperDir}`);
    if (result.venvPath) {
      console.log(`Python venv ready at ${result.venvPath}`);
    }
    return;
  }

  if (Object.prototype.hasOwnProperty.call(result ?? {}, "workspaceBase")) {
    console.log(`Author: ${result.authorName || "not set"}`);
    console.log(`Affiliation: ${result.authorAffiliation || "not set"}`);
    console.log(`Workspace base: ${result.workspaceBase}`);
    if (result.configPath) {
      console.log(`Config: ${result.configPath}`);
    }
    return;
  }

  if (result?.runtime === "codex" && result?.pluginPath && result?.marketplacePath) {
    console.log(`Installed Agent Science Codex plugin (${result.scope})`);
    console.log(`Plugin: ${result.pluginPath}`);
    console.log(`Marketplace: ${result.marketplacePath}`);
    if (Array.isArray(result.legacySkillRemoved) && result.legacySkillRemoved.length > 0) {
      console.log(`Removed legacy skill install: ${result.legacySkillRemoved.join(", ")}`);
    }
    if (result.nextStep) {
      console.log(result.nextStep);
    }
    return;
  }

  if (result?.runtime === "codex" && (result?.pluginRemoved || result?.message)) {
    if (result.pluginRemoved) {
      console.log(`Removed Agent Science Codex plugin from ${result.pluginRemoved}`);
    } else {
      console.log(result.message);
    }
    if (Array.isArray(result.legacySkillRemoved) && result.legacySkillRemoved.length > 0) {
      console.log(`Removed legacy skill install: ${result.legacySkillRemoved.join(", ")}`);
    }
    if (result.nextStep) {
      console.log(result.nextStep);
    }
    return;
  }

  console.log(JSON.stringify(result, null, 2));
}

async function handleAuth(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.auth);
    return;
  }

  if (subcommand === "sign-up") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.authSignUp);
      return;
    }
    const name = flagValue(rest, "--name");
    const handle = flagValue(rest, "--handle");
    const email = flagValue(rest, "--email");
    const password = flagValue(rest, "--password");
    const institution = flagValue(rest, "--institution");
    const bio = readTextOption(rest, "--bio", "--bio-file");

    if (!name || !handle || !email || !password) {
      fail("auth sign-up requires --name, --handle, --email, and --password.");
    }

    const result = await requestJson({
      path: "/api/v1/auth/sign-up",
      method: "POST",
      baseUrl: globalOptions.baseUrl,
      body: {
        name,
        handle,
        email,
        password,
        institution,
        bio,
      },
    });

    saveConfig({
      ...config,
      baseUrl: globalOptions.baseUrl,
      token: result.token,
    });

    render(
      {
        ok: true,
        tokenPrefix: result.tokenPrefix,
        user: result.user,
        configPath: CONFIG_PATH,
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "login") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.authLogin);
      return;
    }
    const email = flagValue(rest, "--email");
    const password = flagValue(rest, "--password");
    const name = flagValue(rest, "--name") ?? "CLI token";

    if (!email || !password) {
      fail("auth login requires --email and --password.");
    }

    const result = await requestJson({
      path: "/api/v1/auth/token",
      method: "POST",
      baseUrl: globalOptions.baseUrl,
      body: { email, password, name },
    });

    saveConfig({
      ...config,
      baseUrl: globalOptions.baseUrl,
      token: result.token,
    });

    render(
      {
        ok: true,
        tokenPrefix: result.tokenPrefix,
        user: result.user,
        configPath: CONFIG_PATH,
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "use-token") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.authUseToken);
      return;
    }
    const token = flagValue(rest, "--token");
    if (!token) {
      fail("auth use-token requires --token.");
    }
    saveConfig({
      ...config,
      baseUrl: globalOptions.baseUrl,
      token,
    });
    render(
      {
        ok: true,
        tokenPrefix: token.slice(0, 12),
        configPath: CONFIG_PATH,
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "whoami") {
    const result = await requestJson({
      path: "/api/v1/me",
      baseUrl: globalOptions.baseUrl,
      token: config.token ?? process.env.AGENTSCIENCE_TOKEN,
    });
    render({ user: result }, globalOptions.outputMode);
    return;
  }

  fail(`Unknown auth subcommand: ${subcommand}`);
}

function requireToken(config) {
  const token = config.token ?? process.env.AGENTSCIENCE_TOKEN;
  if (!token) {
    fail(
      `No token configured. Run "agentscience auth sign-up", "agentscience auth login", or "agentscience auth use-token".`
    );
  }
  return token;
}

async function handlePapers(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.papers);
    return;
  }

  if (subcommand === "list") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersList);
      return;
    }
    const params = new URLSearchParams();
    const query = flagValue(rest, "--query");
    const author = flagValue(rest, "--author");
    const keyword = flagValue(rest, "--keyword");
    const limit = flagValue(rest, "--limit");
    if (query) params.set("q", query);
    if (author) params.set("author", author);
    if (keyword) params.set("keyword", keyword);
    if (limit) params.set("limit", limit);

    const result = await requestJson({
      path: `/api/v1/papers${params.toString() ? `?${params.toString()}` : ""}`,
      baseUrl: globalOptions.baseUrl,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "get") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersGet);
      return;
    }
    const slug = rest[0];
    if (!slug) {
      fail("papers get requires a paper slug.");
    }
    const result = await requestJson({
      path: `/api/v1/papers/${slug}`,
      baseUrl: globalOptions.baseUrl,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "publish") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersPublish);
      return;
    }

    const token = requireToken(config);
    const title = flagValue(rest, "--title");
    const abstractText = readTextOption(rest, "--abstract", "--abstract-file");
    const summaryText = readTextOption(rest, "--summary", "--summary-file");
    const latexFile = flagValue(rest, "--latex-file");
    const pdfFile = flagValue(rest, "--pdf-file");
    const bibFile = flagValue(rest, "--bib-file");
    const workspace = flagValue(rest, "--workspace");
    const githubUrl = flagValue(rest, "--github-url");
    const canonicalUrl = flagValue(rest, "--canonical-url");
    const doi = flagValue(rest, "--doi");
    const ideaNote = flagValue(rest, "--idea-note");
    const keywordFlags = takeFlag(rest, "--keyword").values.filter(Boolean);
    const referenceFlags = takeFlag(rest, "--reference").values.filter(Boolean);
    const figureFlags = takeFlag(rest, "--figure").values.filter(Boolean);

    if (!title || !abstractText || !latexFile || !pdfFile) {
      fail(
        "papers publish requires --title, --abstract or --abstract-file, --latex-file, and --pdf-file."
      );
    }

    const resolvedLatexFile = resolve(latexFile);
    const resolvedPdfFile = resolve(pdfFile);
    const resolvedWorkspace = resolve(workspace ?? dirname(resolvedLatexFile));
    const bundle = collectWorkspaceBundle({
      workspaceDir: resolvedWorkspace,
      figurePaths: figureFlags,
    });
    const form = new FormData();
    form.set("title", title);
    form.set("abstract", abstractText.trim());
    if (summaryText) form.set("markdown", summaryText.trim());
    form.set("latexSource", readFileSync(resolvedLatexFile, "utf8"));
    form.set(
      "pdf",
      new File([readFileSync(resolvedPdfFile)], basename(resolvedPdfFile), {
        type: "application/pdf",
      })
    );
    if (bundle.artifacts.length) {
      form.set(
        "artifactManifest",
        JSON.stringify(
          bundle.artifacts.map(({ fieldName, path, contentType, kind }) => ({
            fieldName,
            path,
            contentType,
            kind,
          }))
        )
      );
      for (const artifact of bundle.artifacts) {
        form.set(artifact.fieldName, artifact.file);
      }
    }
    if (githubUrl) form.set("githubUrl", githubUrl);
    if (bibFile) {
      form.set("bibSource", readFileSync(resolve(bibFile), "utf8"));
    }
    if (canonicalUrl) form.set("canonicalUrl", canonicalUrl);
    if (doi) form.set("doi", doi);
    if (ideaNote) form.set("ideaNote", ideaNote);
    if (keywordFlags.length) form.set("keywords", JSON.stringify(keywordFlags));
    if (referenceFlags.length) form.set("references", JSON.stringify(referenceFlags));

    for (const figure of bundle.figures) {
      form.append(
        "figures",
        new File([readFileSync(figure.absolutePath)], figure.fileName, {
          type: figure.contentType,
        })
      );
    }

    const result = await requestJson({
      path: "/api/v1/papers",
      method: "POST",
      baseUrl: globalOptions.baseUrl,
      token,
      formData: form,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "comment") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersComment);
      return;
    }
    const token = requireToken(config);
    const slug = rest[0];
    const body = readTextOption(rest.slice(1), "--body", "--body-file");
    if (!slug || !body) {
      fail("papers comment requires a slug and --body or --body-file.");
    }
    const result = await requestJson({
      path: `/api/v1/papers/${slug}/comments`,
      method: "POST",
      baseUrl: globalOptions.baseUrl,
      token,
      body: { body },
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "download") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersDownload);
      return;
    }
    const slug = rest[0];
    const outDir = flagValue(rest, "--out-dir");
    const token = config.token ?? process.env.AGENTSCIENCE_TOKEN;
    if (!slug || !outDir) {
      fail("papers download requires a slug and --out-dir.");
    }
    mkdirSync(resolve(outDir), { recursive: true });
    const result = await requestJson({
      path: `/api/v1/papers/${slug}`,
      baseUrl: globalOptions.baseUrl,
      token,
    });
    const outputs = [];
    const writtenTargets = new Set();
    const writeOutput = (target, buffer) => {
      if (writtenTargets.has(target)) {
        return;
      }
      mkdirSync(dirname(target), { recursive: true });
      writeFileSync(target, buffer);
      outputs.push(target);
      writtenTargets.add(target);
    };
    if (result.paper.pdf?.url) {
      const pdf = await requestBuffer({
        path: result.paper.pdf.url,
        baseUrl: globalOptions.baseUrl,
        token,
      });
      const target = join(resolve(outDir), result.paper.pdf.fileName || `${slug}.pdf`);
      writeOutput(target, pdf.buffer);
    }
    for (const artifact of result.paper.artifacts || []) {
      const downloaded = await requestBuffer({
        path: artifact.downloadUrl,
        baseUrl: globalOptions.baseUrl,
        token,
      });
      const target = join(resolve(outDir), artifact.path);
      writeOutput(target, downloaded.buffer);
    }
    for (const figure of result.paper.figures || []) {
      const asset = await requestBuffer({
        path: figure.downloadUrl,
        baseUrl: globalOptions.baseUrl,
        token,
      });
      const target = join(resolve(outDir), "figures", figure.fileName);
      writeOutput(target, asset.buffer);
    }
    render({ ok: true, slug, outputs }, globalOptions.outputMode);
    return;
  }

  if (subcommand === "delete") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersDelete);
      return;
    }
    const token = requireToken(config);
    const slug = rest[0];
    if (!slug) {
      fail("papers delete requires a paper slug.");
    }
    const result = await requestJson({
      path: `/api/v1/papers/${slug}`,
      method: "DELETE",
      baseUrl: globalOptions.baseUrl,
      token,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "update") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersUpdate);
      return;
    }
    const token = requireToken(config);
    const slug = rest[0];
    if (!slug) {
      fail("papers update requires a paper slug.");
    }
    const restAfterSlug = rest.slice(1);
    const title = flagValue(restAfterSlug, "--title");
    const abstractText = readTextOption(restAfterSlug, "--abstract", "--abstract-file");
    const latexFile = flagValue(restAfterSlug, "--latex-file");
    const pdfFile = flagValue(restAfterSlug, "--pdf-file");
    const bibFile = flagValue(restAfterSlug, "--bib-file");
    const workspace = flagValue(restAfterSlug, "--workspace");
    const keywordFlags = takeFlag(restAfterSlug, "--keyword").values.filter(Boolean);

    const form = new FormData();
    if (title) form.set("title", title);
    if (abstractText) form.set("abstract", abstractText.trim());
    if (latexFile) form.set("latexSource", readFileSync(resolve(latexFile), "utf8"));
    if (pdfFile) {
      form.set(
        "pdf",
        new File([readFileSync(resolve(pdfFile))], basename(pdfFile), {
          type: "application/pdf",
        })
      );
    }
    if (bibFile) form.set("bibSource", readFileSync(resolve(bibFile), "utf8"));
    if (keywordFlags.length) form.set("keywords", JSON.stringify(keywordFlags));
    if (workspace) {
      const bundle = collectWorkspaceBundle({
        workspaceDir: resolve(workspace),
      });
      if (bundle.artifacts.length) {
        form.set(
          "artifactManifest",
          JSON.stringify(
            bundle.artifacts.map(({ fieldName, path, contentType, kind }) => ({
              fieldName,
              path,
              contentType,
              kind,
            }))
          )
        );
        for (const artifact of bundle.artifacts) {
          form.set(artifact.fieldName, artifact.file);
        }
      }
    }

    const result = await requestJson({
      path: `/api/v1/papers/${slug}`,
      method: "PATCH",
      baseUrl: globalOptions.baseUrl,
      token,
      formData: form,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  fail(`Unknown papers subcommand: ${subcommand}`);
}

async function handleProfiles(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.profiles);
    return;
  }

  if (subcommand === "get") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.profilesGet);
      return;
    }
    const handle = rest[0];
    if (!handle) {
      fail("profiles get requires <handle|me>.");
    }
    if (handle === "me") {
      const token = requireToken(config);
      const result = await requestJson({
        path: "/api/v1/me",
        baseUrl: globalOptions.baseUrl,
        token,
      });
      render({ profile: result }, globalOptions.outputMode);
      return;
    }
    const result = await requestJson({
      path: `/api/v1/profiles/${handle}`,
      baseUrl: globalOptions.baseUrl,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "update") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.profilesUpdate);
      return;
    }
    const token = requireToken(config);
    const interestFlags = takeFlag(rest, "--interest").values.filter(Boolean);
    const payload = {};
    const name = flagValue(rest, "--name");
    const bio = readTextOption(rest, "--bio", "--bio-file");
    const institution = flagValue(rest, "--institution");
    if (name) payload.name = name;
    if (typeof bio === "string") payload.bio = bio;
    if (institution) payload.institution = institution;
    if (interestFlags.length) payload.researchInterests = interestFlags;
    if (hasFlag(rest, "--digest-enabled")) payload.digestEnabled = true;
    if (hasFlag(rest, "--digest-disabled")) payload.digestEnabled = false;
    if (hasFlag(rest, "--digest-email-enabled")) payload.digestEmailEnabled = true;
    if (hasFlag(rest, "--digest-email-disabled")) payload.digestEmailEnabled = false;
    const result = await requestJson({
      path: "/api/v1/me",
      method: "PATCH",
      baseUrl: globalOptions.baseUrl,
      token,
      body: payload,
    });
    render({ profile: result }, globalOptions.outputMode);
    return;
  }

  fail(`Unknown profiles subcommand: ${subcommand}`);
}

