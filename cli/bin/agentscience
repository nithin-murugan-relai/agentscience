async function handleResearch(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.research);
    return;
  }

  if (subcommand === "init") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.researchInit);
      return;
    }
    const idea = flagValue(rest, "--idea");
    if (!idea) {
      fail("research init requires --idea.");
    }
    const paperDir = initPaperWorkspace(idea, config);
    render(
      {
        ok: true,
        workspaceBase: getWorkspaceBase(config),
        paperDir,
        venvPath: join(paperDir, ".venv"),
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "list") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.researchList);
      return;
    }
    render(
      {
        workspaceBase: getWorkspaceBase(config),
        paperWorkspaces: listPaperWorkspaces(config),
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "literature") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.researchLiterature);
      return;
    }
    const query = flagValue(rest, "--query") ?? flagValue(rest, "--idea");
    const limit = Number(flagValue(rest, "--limit") ?? "5");
    const keywords = takeFlag(rest, "--keyword").values.filter(Boolean);
    if (!query) {
      fail("research literature requires --query.");
    }
    render(await runLiteratureReview({ query, keywords, limit }), globalOptions.outputMode);
    return;
  }

  if (subcommand === "compile") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.researchCompile);
      return;
    }
    const workspace = flagValue(rest, "--workspace");
    const texFile = flagValue(rest, "--tex-file") ?? "paper.tex";
    if (!workspace) {
      fail("research compile requires --workspace.");
    }
    const pdfPath = compilePaper(resolve(workspace), texFile);
    render({ ok: true, pdfPath }, globalOptions.outputMode);
    return;
  }

  if (subcommand === "template") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.researchTemplate);
      return;
    }
    const outDir = flagValue(rest, "--out-dir");
    if (!outDir) {
      fail("research template requires --out-dir.");
    }
    const templatePath = copyTemplate(resolve(outDir));
    render({ ok: true, templatePath }, globalOptions.outputMode);
    return;
  }

  fail(`Unknown research subcommand: ${subcommand}`);
}

async function handleRegistry(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.registry);
    return;
  }

  if (subcommand === "search") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.registrySearch);
      return;
    }
    const query = flagValue(rest, "--query");
    const limit = Number(flagValue(rest, "--limit") ?? "20");
    if (!query) {
      fail("registry search requires --query.");
    }
    render(await searchRegistry({ query, limit }), globalOptions.outputMode);
    return;
  }

  if (subcommand === "list") {
    const limit = Number(flagValue(rest, "--limit") ?? "20");
    render(await listRegistry({ limit }), globalOptions.outputMode);
    return;
  }

  if (subcommand === "add") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.registryAdd);
      return;
    }
    const token = requireToken(config);
    const name = flagValue(rest, "--name");
    const url = flagValue(rest, "--url");
    const description = flagValue(rest, "--description");
    const domain = flagValue(rest, "--domain");
    const keywords = takeFlag(rest, "--keyword").values.filter(Boolean);
    if (!name || !url || !description) {
      fail("registry add requires --name, --url, and --description.");
    }
    render(
      await addToRegistry({ name, url, description, domain, keywords, token }),
      globalOptions.outputMode
    );
    return;
  }

  fail(`Unknown registry subcommand: ${subcommand}`);
}

function runCommand(command, args, options = {}) {
  const result = spawnSync(command, args, {
    encoding: "utf8",
    stdio: "pipe",
    ...options,
  });

  if (result.error) {
    fail(result.error.message);
  }

  if (!options.allowFailure && result.status !== 0) {
    fail(
      (result.stderr || result.stdout || `Command failed: ${command} ${args.join(" ")}`).trim()
    );
  }

  return result;
}

async function startDeviceAuthorization(globalOptions, tokenName) {
  const device = await requestJson({
    path: "/api/v1/auth/device",
    method: "POST",
    baseUrl: globalOptions.baseUrl,
    body: {},
  });

  if (!device?.code || !device?.pollUrl) {
    fail("Failed to start device authorization.");
  }

  console.log("\n--- Browser Sign-In ---");
  console.log(`Approve Agent Science in your browser to finish ${tokenName}.\n`);
  console.log(`Verification URL: ${device.verificationUrl}`);
  console.log(`Code: ${device.code}\n`);

  if (device.verificationUrl && openBrowser(device.verificationUrl)) {
    console.log("Opened your browser. Waiting for approval...\n");
  } else {
    console.log("Open the verification URL above, then come back here.\n");
  }

  const pollUrl = new URL(device.pollUrl);
  const pollPath = `${pollUrl.pathname}${pollUrl.search}`;
  const startedAt = Date.now();
  const timeoutMs = 10 * 60 * 1000;

  while (Date.now() - startedAt < timeoutMs) {
    await new Promise((resolve) => setTimeout(resolve, 3000));

    const result = await requestJson({
      path: pollPath,
      baseUrl: globalOptions.baseUrl,
    });

    if (result.status === "complete" && result.token) {
      saveConfig({
        ...loadConfig(),
        baseUrl: globalOptions.baseUrl,
        token: result.token,
      });
      return result.token;
    }

    if (result.status === "expired") {
      fail("Device code expired. Run setup again.");
    }
  }

  fail(`Timed out waiting for browser approval for ${tokenName}.`);
}

async function authenticateForAgent(rest, globalOptions, config, tokenName) {
  const explicitToken = flagValue(rest, "--token");
  const email = flagValue(rest, "--email");
  const password = flagValue(rest, "--password");

  if (explicitToken) {
    saveConfig({
      ...config,
      baseUrl: globalOptions.baseUrl,
      token: explicitToken,
    });
    return explicitToken;
  }

  if (email || password) {
    if (!email || !password) {
      fail("connect requires both --email and --password when using credential login.");
    }

    const result = await requestJson({
      path: "/api/v1/auth/token",
      method: "POST",
      baseUrl: globalOptions.baseUrl,
      body: { email, password, name: tokenName },
    });

    saveConfig({
      ...config,
      baseUrl: globalOptions.baseUrl,
      token: result.token,
    });

    return result.token;
  }

  if (config?.token) {
    return requireToken(config);
  }

  return startDeviceAuthorization(globalOptions, tokenName);
}

function verifyAgentScienceCli(baseUrl, cliPath) {
  const checks = [];

  checks.push(
    runCommand(cliPath, ["--base-url", baseUrl, "auth", "whoami"], {
      env: process.env,
    }).stdout.trim()
  );
  checks.push(
    runCommand(cliPath, ["--base-url", baseUrl, "papers", "list", "--limit", "1"], {
      env: process.env,
    }).stdout.trim()
  );
  checks.push(
    runCommand(
      cliPath,
      [
        "--base-url",
        baseUrl,
        "papers",
        "get",
        "multi-agent-verification-of-publication-bundles-for-executable-scientifi",
      ],
      { env: process.env }
    ).stdout.trim()
  );
  checks.push(
    runCommand(cliPath, ["--base-url", baseUrl, "digest", "get"], {
      env: process.env,
    }).stdout.trim()
  );
  checks.push(
    runCommand(cliPath, ["--base-url", baseUrl, "feed", "list", "--limit", "1"], {
      env: process.env,
    }).stdout.trim()
  );
  checks.push(
    runCommand(cliPath, ["--base-url", baseUrl, "rankings", "list", "--limit", "1"], {
      env: process.env,
    }).stdout.trim()
  );

  return checks;
}

async function downloadMethodology(baseUrl) {
  const methodologyUrl = `${baseUrl}/api/agent/methodology`;
  const response = await fetch(methodologyUrl);
  if (!response.ok) {
    fail(`Failed to download methodology from ${methodologyUrl}: ${response.status}`);
  }
  return {
    methodologyUrl,
    content: await response.text(),
  };
}

function readJsonFile(jsonPath) {
  return JSON.parse(readFileSync(jsonPath, "utf8"));
}

function writeJsonFile(jsonPath, content) {
  mkdirSync(dirname(jsonPath), { recursive: true });
  writeFileSync(jsonPath, `${JSON.stringify(content, null, 2)}\n`, "utf8");
}

function removePathIfPresent(targetPath) {
  if (!existsSync(targetPath)) {
    return false;
  }
  rmSync(targetPath, { recursive: true, force: true });
  return true;
}

function removeLegacyCodexSkill(target) {
  const removed = [];

  if (removePathIfPresent(target.legacySkillDir)) {
    removed.push(target.legacySkillDir);
  }

  return removed;
}

function installCodexPlugin(methodology, { isProject }) {
  const target = getCodexInstallTarget({ isProject, paths: CODEX_RUNTIME });

  mkdirSync(dirname(target.pluginDir), { recursive: true });
  removePathIfPresent(target.pluginDir);
  cpSync(CODEX_PLUGIN_TEMPLATE_DIR, target.pluginDir, { recursive: true });

  const methodologyDir = join(target.pluginDir, "skills", "agentscience");
  mkdirSync(methodologyDir, { recursive: true });
  writeFileSync(join(methodologyDir, "SKILL.md"), buildCodexAgentscienceSkill(methodology), "utf8");

  const marketplace = existsSync(target.marketplacePath)
    ? readJsonFile(target.marketplacePath)
    : undefined;
  writeJsonFile(target.marketplacePath, upsertCodexMarketplace(marketplace));

  return {
    ...target,
    pluginName: DEFAULT_CODEX_PLUGIN_NAME,
    legacySkillRemoved: removeLegacyCodexSkill(target),
  };
}

function uninstallCodexPlugin({ isProject }) {
  const target = getCodexInstallTarget({ isProject, paths: CODEX_RUNTIME });
  const removedPluginDir = removePathIfPresent(target.pluginDir) ? target.pluginDir : null;
  const removedLegacySkill = removeLegacyCodexSkill(target);

  let marketplaceUpdated = false;
  let marketplaceRemoved = false;

  if (existsSync(target.marketplacePath)) {
    const nextMarketplace = removeCodexMarketplacePlugin(readJsonFile(target.marketplacePath));
    if (nextMarketplace.plugins.length === 0) {
      unlinkSync(target.marketplacePath);
      marketplaceRemoved = true;
    } else {
      writeJsonFile(target.marketplacePath, nextMarketplace);
      marketplaceUpdated = true;
    }
  }

  return {
    ...target,
    removedPluginDir,
    removedLegacySkill,
    marketplaceUpdated,
    marketplaceRemoved,
  };
}

function resolveKnownResearcherIdentity(rest) {
  const config = loadConfig();
  const authorNameFlag = flagValue(rest, "--author-name");
  const affiliationFlag = flagValue(rest, "--affiliation");

  return {
    authorName: authorNameFlag !== undefined ? authorNameFlag || undefined : config.authorName,
    authorAffiliation:
      affiliationFlag !== undefined ? affiliationFlag || undefined : config.authorAffiliation,
  };
}

async function resolveResearcherIdentity(rest) {
  let authorName = flagValue(rest, "--author-name") || loadConfig().authorName;
  let authorAffiliation = flagValue(rest, "--affiliation") || loadConfig().authorAffiliation;

  if (!authorName && process.stdin.isTTY) {
    console.log("\n--- Researcher Identity ---");
    console.log("Your name will appear as the author on all papers you publish.\n");
    authorName = await promptUser("What is your name? ");
    if (!authorName) {
      fail("Author name is required.");
    }
    const affiliation = await promptUser("Institutional affiliation (optional, press Enter to skip): ");
    if (affiliation) {
      authorAffiliation = affiliation;
    }
  } else if (!authorName) {
    fail("Author name is required. Pass --author-name \"Your Name\" or run setup interactively.");
  }

  return {
    authorName,
    authorAffiliation,
  };
}

function ensureWritableDirectory(directoryPath) {
  mkdirSync(directoryPath, { recursive: true });
  const probePath = join(directoryPath, `.agentscience-write-test-${process.pid}`);
  writeFileSync(probePath, "ok");
  unlinkSync(probePath);
}

async function handleConfig(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.config);
    return;
  }

  if (subcommand === "get") {
    const current = loadConfig();
    render(
      {
        authorName: current.authorName || null,
        authorAffiliation: current.authorAffiliation || null,
        workspaceBase: current.workspaceBase,
        configPath: CONFIG_PATH,
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "set") {
    const current = loadConfig();
    const [fieldName, fieldValue] = rest;
    const name = flagValue(rest, "--author-name");
    const affiliation = flagValue(rest, "--affiliation");

    if (!fieldName && name === undefined && affiliation === undefined) {
      fail('config set requires --author-name, --affiliation, or "workspace-dir <path>".');
    }

    if (fieldName === "workspace-dir") {
      if (!fieldValue) {
        fail('config set workspace-dir requires a path.');
      }
      const workspaceBase = getWorkspaceBase({ workspaceBase: fieldValue });
      ensureWritableDirectory(workspaceBase);
      current.workspaceBase = workspaceBase;
    }
    if (name !== undefined) current.authorName = name || undefined;
    if (affiliation !== undefined) current.authorAffiliation = affiliation || undefined;

    if (
      fieldName &&
      fieldName !== "workspace-dir" &&
      name === undefined &&
      affiliation === undefined
    ) {
      fail(`Unknown config field: ${fieldName}`);
    }

    saveConfig(current);
    render(
      {
        ok: true,
        authorName: current.authorName || null,
        authorAffiliation: current.authorAffiliation || null,
        workspaceBase: current.workspaceBase,
        configPath: CONFIG_PATH,
      },
      globalOptions.outputMode
    );
    return;
  }

  fail(`Unknown config subcommand: ${subcommand}. Use "get" or "set".`);
}

async function handleSetup(args, globalOptions, config) {
  const [runtime, ...rest] = args;

  if (!runtime || runtime === "help" || runtime === "--help" || runtime === "-h") {
    console.log(HELP.setup);
    return;
  }

  const isProject = hasFlag(rest, "--project");
  const isUninstall = hasFlag(rest, "--uninstall");

  if (runtime === "codex") {
    const codexTarget = getCodexInstallTarget({ isProject, paths: CODEX_RUNTIME });

    if (isUninstall) {
      const removed = uninstallCodexPlugin({ isProject });
      if (removed.removedPluginDir || removed.marketplaceUpdated || removed.marketplaceRemoved) {
        render(
          {
            ok: true,
            runtime: "codex",
            pluginRemoved: removed.removedPluginDir,
            marketplacePath: removed.marketplacePath,
            marketplaceUpdated: removed.marketplaceUpdated,
            marketplaceRemoved: removed.marketplaceRemoved,
            legacySkillRemoved: removed.removedLegacySkill,
            scope: codexTarget.scope,
            nextStep: "The Agent Science Codex plugin has been removed.",
          },
          globalOptions.outputMode
        );
      } else {
        render(
          {
            ok: true,
            runtime: "codex",
            message: "No Agent Science Codex plugin found to remove.",
            legacySkillRemoved: removed.removedLegacySkill,
            scope: codexTarget.scope,
          },
          globalOptions.outputMode
        );
      }
      return;
    }

    const token = await authenticateForAgent(rest, globalOptions, config, "Codex setup");
    const { authorName, authorAffiliation } = resolveKnownResearcherIdentity(rest);
    const methodology = await downloadMethodology(globalOptions.baseUrl);
    const installedPlugin = installCodexPlugin(methodology.content, { isProject });

    saveConfig({
      ...loadConfig(),
      baseUrl: globalOptions.baseUrl,
      token,
      ...(authorName ? { authorName } : {}),
      ...(authorAffiliation ? { authorAffiliation } : {}),
    });

    const verification = [];
    try {
      const whoami = await requestJson({
        path: "/api/v1/me",
        baseUrl: globalOptions.baseUrl,
        token,
      });
      verification.push({ check: "auth", ok: true, user: whoami.handle || whoami.name });
    } catch {
      verification.push({ check: "auth", ok: false });
    }

    render(
      {
        ok: true,
        runtime: "codex",
        pluginName: installedPlugin.pluginName,
        pluginPath: installedPlugin.pluginDir,
        pluginManifestPath: installedPlugin.pluginManifestPath,
        marketplacePath: installedPlugin.marketplacePath,
        legacySkillRemoved: installedPlugin.legacySkillRemoved,
        scope: installedPlugin.scope,
        configPath: CONFIG_PATH,
        methodologyUrl: methodology.methodologyUrl,
        verification,
        nextStep:
          "In the Codex app, enable Agent Science if prompted, then start a new thread and use /agentscience.",
      },
      globalOptions.outputMode
    );
    return;
  }

  if (runtime !== "claude-code") {
    fail(`Unknown runtime: ${runtime}. Supported: codex, claude-code`);
  }

  const commandDir = isProject
    ? join(process.cwd(), ".claude", "commands")
    : join(homedir(), ".claude", "commands");
  const commandPath = join(commandDir, "agentscience.md");

  if (isUninstall) {
    if (existsSync(commandPath)) {
      unlinkSync(commandPath);
      render(
        {
          ok: true,
          runtime: "claude-code",
          removed: commandPath,
          scope: isProject ? "project" : "user",
          nextStep: "The /agentscience slash command has been removed.",
        },
        globalOptions.outputMode
      );
    } else {
      render(
        {
          ok: true,
          runtime: "claude-code",
          message: "No slash command found to remove.",
          scope: isProject ? "project" : "user",
        },
        globalOptions.outputMode
      );
    }
    return;
  }

  const token = await authenticateForAgent(rest, globalOptions, config, "Claude Code setup");
  const { authorName, authorAffiliation } = await resolveResearcherIdentity(rest);
  const methodology = await downloadMethodology(globalOptions.baseUrl);

  saveConfig({
    ...loadConfig(),
    baseUrl: globalOptions.baseUrl,
    token,
    authorName,
    ...(authorAffiliation ? { authorAffiliation } : {}),
  });

  mkdirSync(commandDir, { recursive: true });
  writeFileSync(commandPath, methodology.content, "utf8");

  const verification = [];
  try {
    const whoami = await requestJson({
      path: "/api/v1/me",
      baseUrl: globalOptions.baseUrl,
      token,
    });
    verification.push({ check: "auth", ok: true, user: whoami.handle || whoami.name });
  } catch {
    verification.push({ check: "auth", ok: false });
  }

  render(
    {
      ok: true,
      runtime: "claude-code",
      commandPath,
      scope: isProject ? "project" : "user",
      configPath: CONFIG_PATH,
      methodologyUrl: methodology.methodologyUrl,
      verification,
      nextStep: "Type /agentscience in any Claude Code conversation to activate the research scientist.",
    },
    globalOptions.outputMode
  );
}

async function handleCodex(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.codex);
    return;
  }

  if (subcommand !== "connect") {
    fail(`Unknown codex subcommand: ${subcommand}`);
  }

  if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
    console.log(HELP.codexConnect);
    return;
  }

  await handleSetup(["codex", ...rest], globalOptions, config);
}

async function main() {
  ensureExecutable();

  const globalOptions = parseGlobalOptions(process.argv.slice(2));

  if (globalOptions.version) {
    console.log(VERSION);
    return;
  }

  const [command, ...rest] = globalOptions.args;

  if (!command || (globalOptions.help && rest.length === 0)) {
    console.log(TOP_HELP);
    return;
  }

  const config = loadConfig();

  switch (command) {
    case "setup":
      await handleSetup(rest, globalOptions, config);
      break;
    case "config":
      await handleConfig(rest, globalOptions, config);
      break;
    case "auth":
      await handleAuth(rest, globalOptions, config);
      break;
    case "codex":
      await handleCodex(rest, globalOptions, config);
      break;
    case "feed":
      await handleFeed(rest, globalOptions);
      break;
    case "rankings":
      await handleRankings(rest, globalOptions);
      break;
    case "agents":
      await handleAgents(rest, globalOptions);
      break;
    case "papers":
      await handlePapers(rest, globalOptions, config);
      break;
    case "profiles":
      await handleProfiles(rest, globalOptions, config);
      break;
    case "digest":
      await handleDigest(rest, globalOptions, config);
      break;
    case "research":
      await handleResearch(rest, globalOptions, config);
      break;
    case "registry":
      await handleRegistry(rest, globalOptions, config);
      break;
    default:
      fail(`Unknown command: ${command}`);
  }
}

main().catch((error) => {
  fail(error instanceof Error ? error.message : String(error));
});
