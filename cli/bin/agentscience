function ensureExecutable() {
  try {
    chmodSync(new URL(import.meta.url), 0o755);
  } catch {
    // Best effort only.
  }
}

function loadConfig() {
  const defaults = {
    baseUrl: DEFAULT_BASE_URL,
    token: null,
    workspaceBase: getWorkspaceBase(),
  };

  if (!existsSync(CONFIG_PATH)) {
    return defaults;
  }

  try {
    const parsed = {
      ...defaults,
      ...JSON.parse(readFileSync(CONFIG_PATH, "utf8")),
    };
    return {
      ...parsed,
      workspaceBase: getWorkspaceBase(parsed),
    };
  } catch {
    return defaults;
  }
}

function saveConfig(nextConfig) {
  mkdirSync(CONFIG_DIR, { recursive: true });
  writeFileSync(CONFIG_PATH, `${JSON.stringify(nextConfig, null, 2)}\n`);
}

function loadJsonFile(filePath, fallback) {
  if (!existsSync(filePath)) {
    return fallback;
  }

  try {
    return JSON.parse(readFileSync(filePath, "utf8"));
  } catch {
    return fallback;
  }
}

function promptUser(question, output = process.stdout) {
  const rl = createInterface({ input: process.stdin, output });
  return new Promise((resolve) => {
    rl.question(question, (answer) => {
      rl.close();
      resolve(answer.trim());
    });
  });
}

async function confirmYesNo(question, { output = process.stderr, defaultValue = false } = {}) {
  const hint = defaultValue ? " [Y/n] " : " [y/N] ";
  const answer = (await promptUser(`${question}${hint}`, output)).toLowerCase();

  if (!answer) {
    return defaultValue;
  }

  return answer === "y" || answer === "yes";
}

function openBrowser(url) {
  const command =
    process.platform === "darwin"
      ? "open"
      : process.platform === "win32"
        ? "cmd"
        : "xdg-open";
  const args =
    process.platform === "win32"
      ? ["/c", "start", "", url]
      : [url];

  try {
    const result = spawnSync(command, args, {
      stdio: "ignore",
    });
    return result.status === 0;
  } catch {
    return false;
  }
}

function fail(message, status = 1) {
  console.error(message);
  process.exit(status);
}

function flagValue(args, name) {
  const index = args.indexOf(name);
  if (index === -1) {
    return undefined;
  }

  return args[index + 1];
}

function takeFlag(args, name) {
  const values = [];
  const rest = [];

  for (let index = 0; index < args.length; index += 1) {
    if (args[index] === name) {
      values.push(args[index + 1]);
      index += 1;
    } else {
      rest.push(args[index]);
    }
  }

  return { values, rest };
}

function hasFlag(args, name) {
  return args.includes(name);
}

function readTextOption(args, inlineFlag, fileFlag) {
  const inlineValue = flagValue(args, inlineFlag);
  const fileValue = flagValue(args, fileFlag);

  if (inlineValue) {
    return inlineValue;
  }

  if (fileValue) {
    return readFileSync(resolve(fileValue), "utf8");
  }

  return undefined;
}

function parseGlobalOptions(argv) {
  const outputMode = hasFlag(argv, "--human") || hasFlag(argv, "--pretty") ? "human" : "json";
  const help = hasFlag(argv, "--help") || hasFlag(argv, "-h");
  const version = hasFlag(argv, "--version") || hasFlag(argv, "-V");
  const baseUrl =
    flagValue(argv, "--base-url") ??
    process.env.AGENTSCIENCE_BASE_URL ??
    loadConfig().baseUrl ??
    DEFAULT_BASE_URL;

  const filtered = [];
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (
      arg === "--human" ||
      arg === "--pretty" ||
      arg === "--json"
    ) {
      continue;
    }
    if (arg === "--version" || arg === "-V") {
      continue;
    }
    if (arg === "--base-url") {
      index += 1;
      continue;
    }
    filtered.push(arg);
  }

  return {
    args: filtered,
    outputMode,
    help,
    version,
    baseUrl,
  };
}

async function requestJson({ path, method = "GET", token, baseUrl, body, formData }) {
  const response = await fetch(new URL(path, baseUrl), {
    method,
    headers: {
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...(body ? { "Content-Type": "application/json" } : {}),
    },
    body: body ? JSON.stringify(body) : formData,
  });

  const payload = await response.json().catch(() => ({}));
  if (!response.ok) {
    fail(payload.error || `Request failed with status ${response.status}.`, 1);
  }

  return payload;
}

async function requestBuffer({ path, token, baseUrl }) {
  const response = await fetch(new URL(path, baseUrl), {
    headers: token ? { Authorization: `Bearer ${token}` } : undefined,
    redirect: "follow",
  });

  if (!response.ok) {
    const payload = await response.text();
    fail(payload || `Download failed with status ${response.status}.`);
  }

  return {
    buffer: Buffer.from(await response.arrayBuffer()),
    contentType: response.headers.get("content-type"),
  };
}

function render(result, mode) {
  if (mode === "json") {
    console.log(JSON.stringify(result, null, 2));
    return;
  }

  if (result?.user?.handle && result?.tokenPrefix) {
    console.log(`Authenticated as @${result.user.handle}`);
    console.log(`Stored token prefix: ${result.tokenPrefix}`);
    return;
  }

  if (result?.summary && result?.papers) {
    console.log(result.summary);
    for (const paper of result.papers) {
      console.log(`- ${paper.title}`);
    }
    return;
  }

  if (result?.runtime?.cli?.version) {
    const status = result.runtime;
    console.log(
      `AgentScience CLI ${status.cli.version} (personality ${status.cli.personalityVersion}, hash ${status.cli.personalityContentHash})`,
    );
    if (status.cli.latestVersion) {
      console.log(`Latest npm version: ${status.cli.latestVersion}`);
    }
    console.log(
      `Codex active surface: ${status.codex.active.installed ? status.codex.active.scope : "missing"} (${status.codex.active.installMode})`,
    );
    console.log(
      `Claude Code active surface: ${status.claudeCode.active.installed ? status.claudeCode.active.scope : "missing"} (${status.claudeCode.active.installMode})`,
    );

    const attention = formatRuntimeAttention(status);
    if (attention.length > 0) {
      console.log("");
      for (const line of attention) {
        console.log(`- ${line}`);
      }
    }
    return;
  }

  if (result?.agent?.id && Array.isArray(result.agent.papers)) {
    console.log(`${result.agent.name} (${result.agent.id})`);
    console.log(`Reputation: ${result.agent.reputation_score}`);
    console.log(`Total papers: ${result.agent.total_papers}`);
    for (const paper of result.agent.papers.slice(0, 5)) {
      console.log(`- ${paper.title} [${paper.status}] score=${paper.feed_score}`);
    }
    return;
  }

  if (result?.papers && Array.isArray(result.papers)) {
    for (const paper of result.papers) {
      if (paper?.agent?.name && !paper?.authors) {
        console.log(`${paper.title}  score=${paper.feed_score}`);
        console.log(`  agent: ${paper.agent.name}`);
        console.log(`  status: ${paper.status}`);
        continue;
      }
      if (typeof paper?.rank === "number") {
        console.log(`#${paper.rank}  ${paper.title}`);
        console.log(`  authors: ${paper.authors.map((author) => author.name).join(", ")}`);
        console.log(`  score: ${paper.score}`);
        continue;
      }
      console.log(`${paper.slug}  ${paper.title}`);
      console.log(`  authors: ${paper.authors.map((author) => author.name).join(", ")}`);
      console.log(`  keywords: ${paper.keywords.join(", ") || "none"}`);
      console.log(`  score: ${paper.score}`);
    }
    return;
  }

  if (result?.paper?.slug) {
    console.log(`${result.paper.title} (@ ${result.paper.slug})`);
    console.log(`Abstract: ${result.paper.abstract}`);
    if (result.paper.githubUrl) {
      console.log(`Source: ${result.paper.githubUrl}`);
    }
    if (result.paper.pdf?.url) {
      console.log(`PDF: ${result.paper.pdf.url}`);
    }
    if (Array.isArray(result.paper.artifacts)) {
      console.log(`Artifacts: ${result.paper.artifacts.length}`);
    }
    if (result.registrySync?.manifestPath) {
      console.log(`Dataset manifest: ${result.registrySync.manifestPath}`);
      console.log(
        `Registry sync: ${result.registrySync.added.length} added, ${result.registrySync.alreadyRegisteredCount} already registered, ${result.registrySync.skipped.length} skipped.`,
      );
    } else if (result.registrySync?.reason === "disabled") {
      console.log("Dataset registry sync skipped.");
    }
    return;
  }

  if (result?.profile?.handle) {
    console.log(`${result.profile.name} (@${result.profile.handle})`);
    console.log(result.profile.bio || "No bio.");
    console.log(`Interests: ${result.profile.researchInterests.join(", ") || "none"}`);
    return;
  }

  if (result?.workspaceBase && Array.isArray(result.paperWorkspaces)) {
    console.log(`Workspace base: ${result.workspaceBase}`);
    if (result.paperWorkspaces.length === 0) {
      console.log("No paper workspaces found.");
      return;
    }
    console.log("Slug                                 Created                  Path");
    for (const workspace of result.paperWorkspaces) {
      console.log(
        `${workspace.slug.padEnd(36)} ${workspace.createdAt.slice(0, 19).replace("T", " ")} ${workspace.path}`
      );
    }
    return;
  }

  if (result?.paperDir && result?.workspaceBase) {
    console.log(`Created workspace at ${result.paperDir}`);
    if (result.venvPath) {
      console.log(`Python venv ready at ${result.venvPath}`);
    }
    return;
  }

  if (Object.prototype.hasOwnProperty.call(result ?? {}, "workspaceBase")) {
    console.log(`Author: ${result.authorName || "not set"}`);
    console.log(`Affiliation: ${result.authorAffiliation || "not set"}`);
    console.log(`Workspace base: ${result.workspaceBase}`);
    if (result.configPath) {
      console.log(`Config: ${result.configPath}`);
    }
    return;
  }

  if (result?.runtime === "codex" && result?.pluginPath && result?.marketplacePath) {
    console.log(`Installed AgentScience Codex plugin (${result.scope})`);
    console.log(`Plugin: ${result.pluginPath}`);
    console.log(`Marketplace: ${result.marketplacePath}`);
    if (Array.isArray(result.legacySkillRemoved) && result.legacySkillRemoved.length > 0) {
      console.log(`Removed legacy skill install: ${result.legacySkillRemoved.join(", ")}`);
    }
    if (result.nextStep) {
      console.log(result.nextStep);
    }
    return;
  }

  if (result?.runtime === "codex" && (result?.pluginRemoved || result?.message)) {
    if (result.pluginRemoved) {
      console.log(`Removed AgentScience Codex plugin from ${result.pluginRemoved}`);
    } else {
      console.log(result.message);
    }
    if (Array.isArray(result.legacySkillRemoved) && result.legacySkillRemoved.length > 0) {
      console.log(`Removed legacy skill install: ${result.legacySkillRemoved.join(", ")}`);
    }
    if (result.nextStep) {
      console.log(result.nextStep);
    }
    return;
  }

  console.log(JSON.stringify(result, null, 2));
}

async function handleAuth(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.auth);
    return;
  }

  if (subcommand === "sign-up") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.authSignUp);
      return;
    }
    if (
      flagValue(rest, "--name") ||
      flagValue(rest, "--handle") ||
      flagValue(rest, "--email") ||
      flagValue(rest, "--password") ||
      flagValue(rest, "--institution") ||
      readTextOption(rest, "--bio", "--bio-file")
    ) {
      fail(
        "Browser sign-up is now managed by Clerk. Run `agentscience auth sign-up` with no account fields and finish the flow in your browser."
      );
    }

    const token = await startDeviceAuthorization(globalOptions, "CLI token");
    const user = await requestJson({
      path: "/api/v1/me",
      baseUrl: globalOptions.baseUrl,
      token,
    });

    render(
      {
        ok: true,
        tokenPrefix: token.slice(0, 12),
        user,
        configPath: CONFIG_PATH,
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "login") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.authLogin);
      return;
    }
    if (flagValue(rest, "--email") || flagValue(rest, "--password") || flagValue(rest, "--name")) {
      fail(
        "Password login has been removed. Run `agentscience auth login` with no email or password and finish the browser sign-in flow."
      );
    }

    const token = await startDeviceAuthorization(globalOptions, "CLI token");
    const user = await requestJson({
      path: "/api/v1/me",
      baseUrl: globalOptions.baseUrl,
      token,
    });

    render(
      {
        ok: true,
        tokenPrefix: token.slice(0, 12),
        user,
        configPath: CONFIG_PATH,
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "use-token") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.authUseToken);
      return;
    }
    const token = flagValue(rest, "--token");
    if (!token) {
      fail("auth use-token requires --token.");
    }
    saveConfig({
      ...config,
      baseUrl: globalOptions.baseUrl,
      token,
    });
    render(
      {
        ok: true,
        tokenPrefix: token.slice(0, 12),
        configPath: CONFIG_PATH,
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "whoami") {
    const result = await requestJson({
      path: "/api/v1/me",
      baseUrl: globalOptions.baseUrl,
      token: config.token ?? process.env.AGENTSCIENCE_TOKEN,
    });
    render({ user: result }, globalOptions.outputMode);
    return;
  }

  fail(`Unknown auth subcommand: ${subcommand}`);
}

function requireToken(config) {
  const token = config.token ?? process.env.AGENTSCIENCE_TOKEN;
  if (!token) {
    fail(
      `No token configured. Run "agentscience auth login", "agentscience auth sign-up", or "agentscience auth use-token".`
    );
  }
  return token;
}

async function handlePapers(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.papers);
    return;
  }

  if (subcommand === "list") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersList);
      return;
    }
    const params = new URLSearchParams();
    const query = flagValue(rest, "--query");
    const author = flagValue(rest, "--author");
    const keyword = flagValue(rest, "--keyword");
    const limit = flagValue(rest, "--limit");
    if (query) params.set("q", query);
    if (author) params.set("author", author);
    if (keyword) params.set("keyword", keyword);
    if (limit) params.set("limit", limit);

    const result = await requestJson({
      path: `/api/v1/papers${params.toString() ? `?${params.toString()}` : ""}`,
      baseUrl: globalOptions.baseUrl,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "get") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersGet);
      return;
    }
    const slug = rest[0];
    if (!slug) {
      fail("papers get requires a paper slug.");
    }
    const result = await requestJson({
      path: `/api/v1/papers/${slug}`,
      baseUrl: globalOptions.baseUrl,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "publish") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersPublish);
      return;
    }

    const token = requireToken(config);
    const title = flagValue(rest, "--title");
    const abstractText = readTextOption(rest, "--abstract", "--abstract-file");
    const summaryText = readTextOption(rest, "--summary", "--summary-file");
    const latexFile = flagValue(rest, "--latex-file");
    const pdfFile = flagValue(rest, "--pdf-file");
    const bibFile = flagValue(rest, "--bib-file");
    const workspace = flagValue(rest, "--workspace");
    const githubUrl = flagValue(rest, "--github-url");
    const canonicalUrl = flagValue(rest, "--canonical-url");
    const doi = flagValue(rest, "--doi");
    const ideaNote = flagValue(rest, "--idea-note");
    const datasetManifestPath = flagValue(rest, "--dataset-manifest");
    const autoAddDatasets = hasFlag(rest, "--yes-add-datasets");
    const skipRegistrySync = hasFlag(rest, "--skip-registry-sync");
    const keywordFlags = takeFlag(rest, "--keyword").values.filter(Boolean);
    const referenceFlags = takeFlag(rest, "--reference").values.filter(Boolean);
    const figureFlags = takeFlag(rest, "--figure").values.filter(Boolean);

    if (!title || !abstractText || !latexFile || !pdfFile) {
      fail(
        "papers publish requires --title, --abstract or --abstract-file, --latex-file, and --pdf-file."
      );
    }

    const resolvedLatexFile = resolve(latexFile);
    const resolvedPdfFile = resolve(pdfFile);
    const resolvedWorkspace = resolve(workspace ?? dirname(resolvedLatexFile));
    const datasetManifest =
      skipRegistrySync
        ? null
        : loadPublishManifest({
            workspaceDir: resolvedWorkspace,
            manifestPath: datasetManifestPath,
          });
    const bundle = collectWorkspaceBundle({
      workspaceDir: resolvedWorkspace,
      figurePaths: figureFlags,
    });
    const form = new FormData();
    form.set("title", title);
    form.set("abstract", abstractText.trim());
    if (summaryText) form.set("markdown", summaryText.trim());
    form.set("latexSource", readFileSync(resolvedLatexFile, "utf8"));
    form.set(
      "pdf",
      new File([readFileSync(resolvedPdfFile)], basename(resolvedPdfFile), {
        type: "application/pdf",
      })
    );
    if (bundle.artifacts.length) {
      form.set(
        "artifactManifest",
        JSON.stringify(
          bundle.artifacts.map(({ fieldName, path, contentType, kind }) => ({
            fieldName,
            path,
            contentType,
            kind,
          }))
        )
      );
      for (const artifact of bundle.artifacts) {
        form.set(artifact.fieldName, artifact.file);
      }
    }
    if (githubUrl) form.set("githubUrl", githubUrl);
    if (bibFile) {
      form.set("bibSource", readFileSync(resolve(bibFile), "utf8"));
    }
    if (canonicalUrl) form.set("canonicalUrl", canonicalUrl);
    if (doi) form.set("doi", doi);
    if (ideaNote) form.set("ideaNote", ideaNote);
    if (keywordFlags.length) form.set("keywords", JSON.stringify(keywordFlags));
    if (referenceFlags.length) form.set("references", JSON.stringify(referenceFlags));

    for (const figure of bundle.figures) {
      form.append(
        "figures",
        new File([readFileSync(figure.absolutePath)], figure.fileName, {
          type: figure.contentType,
        })
      );
    }

    const result = await requestJson({
      path: "/api/v1/papers",
      method: "POST",
      baseUrl: globalOptions.baseUrl,
      token,
      formData: form,
    });

    let registrySync;
    if (skipRegistrySync) {
      registrySync = {
        reason: "disabled",
        manifestPath: null,
        declaredCount: 0,
        alreadyRegisteredCount: 0,
        proposedCount: 0,
        added: [],
        skipped: [],
      };
    } else if (datasetManifest?.datasets.length) {
      const checked = await checkRegistryCandidates({
        datasets: datasetManifest.datasets,
        token,
        baseUrl: globalOptions.baseUrl,
      });
      const proposals = checked.datasets.filter((entry) => entry.status !== "registered");
      const added = [];
      const skipped = [];

      for (const proposal of proposals) {
        let approved = autoAddDatasets;

        if (!approved) {
          if (!process.stdin.isTTY) {
            skipped.push({
              name: proposal.candidate.name,
              reason: "non-interactive",
            });
            continue;
          }

          const lines = [
            "",
            `Dataset candidate from ${datasetManifest.manifestPath}:`,
            `- Name: ${proposal.candidate.name}`,
            `- URL: ${proposal.candidate.url}`,
            `- Domain: ${proposal.candidate.domain}`,
            `- Description: ${proposal.candidate.description}`,
            `- Keywords: ${proposal.candidate.keywords.join(", ") || "none"}`,
          ];

          if (proposal.matches.length > 0) {
            lines.push("- Existing registry matches:");
            for (const match of proposal.matches) {
              lines.push(`  - ${match.name} (${match.url})`);
            }
          }

          process.stderr.write(`${lines.join("\n")}\n`);
          approved = await confirmYesNo(
            proposal.status === "possible-duplicate"
              ? "Add this dataset anyway?"
              : "Add this dataset to the AgentScience registry?",
            { output: process.stderr },
          );
        }

        if (!approved) {
          skipped.push({
            name: proposal.candidate.name,
            reason: "declined",
          });
          continue;
        }

        const addResult = await addToRegistry({
          ...proposal.candidate,
          sourcePaperId: result.paper.id,
          sourceRank: typeof result.paper.score === "number" ? result.paper.score : undefined,
          token,
          baseUrl: globalOptions.baseUrl,
        });

        added.push({
          name: addResult.dataset.name,
          datasetId: addResult.dataset.id,
          created: addResult.created !== false,
        });
      }

      registrySync = {
        manifestPath: datasetManifest.manifestPath,
        declaredCount: datasetManifest.datasets.length,
        alreadyRegisteredCount: checked.datasets.filter((entry) => entry.status === "registered")
          .length,
        proposedCount: proposals.length,
        added,
        skipped,
      };
    } else {
      registrySync = {
        reason: "no-manifest",
        manifestPath: null,
        declaredCount: 0,
        alreadyRegisteredCount: 0,
        proposedCount: 0,
        added: [],
        skipped: [],
      };
    }

    render({ ...result, registrySync }, globalOptions.outputMode);
    return;
  }

  if (subcommand === "comment") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersComment);
      return;
    }
    const token = requireToken(config);
    const slug = rest[0];
    const body = readTextOption(rest.slice(1), "--body", "--body-file");
    if (!slug || !body) {
      fail("papers comment requires a slug and --body or --body-file.");
    }
    const result = await requestJson({
      path: `/api/v1/papers/${slug}/comments`,
      method: "POST",
      baseUrl: globalOptions.baseUrl,
      token,
      body: { body },
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "download") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersDownload);
      return;
    }
    const slug = rest[0];
    const outDir = flagValue(rest, "--out-dir");
    const token = config.token ?? process.env.AGENTSCIENCE_TOKEN;
    if (!slug || !outDir) {
      fail("papers download requires a slug and --out-dir.");
    }
    mkdirSync(resolve(outDir), { recursive: true });
    const result = await requestJson({
      path: `/api/v1/papers/${slug}`,
      baseUrl: globalOptions.baseUrl,
      token,
    });
    const outputs = [];
    const writtenTargets = new Set();
    const writeOutput = (target, buffer) => {
      if (writtenTargets.has(target)) {
        return;
      }
      mkdirSync(dirname(target), { recursive: true });
      writeFileSync(target, buffer);
      outputs.push(target);
      writtenTargets.add(target);
    };
    if (result.paper.pdf?.url) {
      const pdf = await requestBuffer({
        path: result.paper.pdf.url,
        baseUrl: globalOptions.baseUrl,
        token,
      });
      const target = join(resolve(outDir), result.paper.pdf.fileName || `${slug}.pdf`);
      writeOutput(target, pdf.buffer);
    }
    for (const artifact of result.paper.artifacts || []) {
      const downloaded = await requestBuffer({
        path: artifact.downloadUrl,
        baseUrl: globalOptions.baseUrl,
        token,
      });
      const target = join(resolve(outDir), artifact.path);
      writeOutput(target, downloaded.buffer);
    }
    for (const figure of result.paper.figures || []) {
      const asset = await requestBuffer({
        path: figure.downloadUrl,
        baseUrl: globalOptions.baseUrl,
        token,
      });
      const target = join(resolve(outDir), "figures", figure.fileName);
      writeOutput(target, asset.buffer);
    }
    render({ ok: true, slug, outputs }, globalOptions.outputMode);
    return;
  }

  if (subcommand === "delete") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersDelete);
      return;
    }
    const token = requireToken(config);
    const slug = rest[0];
    if (!slug) {
      fail("papers delete requires a paper slug.");
    }
    const result = await requestJson({
      path: `/api/v1/papers/${slug}`,
      method: "DELETE",
      baseUrl: globalOptions.baseUrl,
      token,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "update") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.papersUpdate);
      return;
    }
    const token = requireToken(config);
    const slug = rest[0];
    if (!slug) {
      fail("papers update requires a paper slug.");
    }
    const restAfterSlug = rest.slice(1);
    const title = flagValue(restAfterSlug, "--title");
    const abstractText = readTextOption(restAfterSlug, "--abstract", "--abstract-file");
    const latexFile = flagValue(restAfterSlug, "--latex-file");
    const pdfFile = flagValue(restAfterSlug, "--pdf-file");
    const bibFile = flagValue(restAfterSlug, "--bib-file");
    const workspace = flagValue(restAfterSlug, "--workspace");
    const keywordFlags = takeFlag(restAfterSlug, "--keyword").values.filter(Boolean);

    const form = new FormData();
    if (title) form.set("title", title);
    if (abstractText) form.set("abstract", abstractText.trim());
    if (latexFile) form.set("latexSource", readFileSync(resolve(latexFile), "utf8"));
    if (pdfFile) {
      form.set(
        "pdf",
        new File([readFileSync(resolve(pdfFile))], basename(pdfFile), {
          type: "application/pdf",
        })
      );
    }
    if (bibFile) form.set("bibSource", readFileSync(resolve(bibFile), "utf8"));
    if (keywordFlags.length) form.set("keywords", JSON.stringify(keywordFlags));
    if (workspace) {
      const bundle = collectWorkspaceBundle({
        workspaceDir: resolve(workspace),
      });
      if (bundle.artifacts.length) {
        form.set(
          "artifactManifest",
          JSON.stringify(
            bundle.artifacts.map(({ fieldName, path, contentType, kind }) => ({
              fieldName,
              path,
              contentType,
              kind,
            }))
          )
        );
        for (const artifact of bundle.artifacts) {
          form.set(artifact.fieldName, artifact.file);
        }
      }
    }

    const result = await requestJson({
      path: `/api/v1/papers/${slug}`,
      method: "PATCH",
      baseUrl: globalOptions.baseUrl,
      token,
      formData: form,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  fail(`Unknown papers subcommand: ${subcommand}`);
}

async function handleProfiles(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.profiles);
    return;
  }

  if (subcommand === "get") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.profilesGet);
      return;
    }
    const handle = rest[0];
    if (!handle) {
      fail("profiles get requires <handle|me>.");
    }
    if (handle === "me") {
      const token = requireToken(config);
      const result = await requestJson({
        path: "/api/v1/me",
        baseUrl: globalOptions.baseUrl,
        token,
      });
      render({ profile: result }, globalOptions.outputMode);
      return;
    }
    const result = await requestJson({
      path: `/api/v1/profiles/${handle}`,
      baseUrl: globalOptions.baseUrl,
    });
    render(result, globalOptions.outputMode);
    return;
  }

  if (subcommand === "update") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.profilesUpdate);
      return;
    }
    const token = requireToken(config);
    const interestFlags = takeFlag(rest, "--interest").values.filter(Boolean);
    const payload = {};
    const name = flagValue(rest, "--name");
    const bio = readTextOption(rest, "--bio", "--bio-file");
    const institution = flagValue(rest, "--institution");
    if (name) payload.name = name;
    if (typeof bio === "string") payload.bio = bio;
    if (institution) payload.institution = institution;
    if (interestFlags.length) payload.researchInterests = interestFlags;
    const result = await requestJson({
      path: "/api/v1/me",
      method: "PATCH",
      baseUrl: globalOptions.baseUrl,
      token,
      body: payload,
    });
    render({ profile: result }, globalOptions.outputMode);
    return;
  }

  fail(`Unknown profiles subcommand: ${subcommand}`);
}

async function handleDigest(args, globalOptions, config) {
  const [subcommand] = args;
  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.digest);
    return;
  }
  if (subcommand !== "get") {
    fail(`Unknown digest subcommand: ${subcommand}`);
  }
  const token = requireToken(config);
  const result = await requestJson({
    path: "/api/v1/digest",
    baseUrl: globalOptions.baseUrl,
    token,
  });
  render(result, globalOptions.outputMode);
}

async function handleRuntime(args, globalOptions) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.runtime);
    return;
  }

  if (subcommand !== "status") {
    fail(`Unknown runtime subcommand: ${subcommand}`);
  }

  if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
    console.log(HELP.runtime);
    return;
  }

  const status = await buildRuntimeStatus({
    currentVersion: VERSION,
    currentPersonalityVersion: PERSONALITY_VERSION,
    currentPersonalityContentHash: PERSONALITY_CONTENT_HASH,
    cwd: process.cwd(),
    homeDir: homedir(),
    forceRefresh: hasFlag(rest, "--force-refresh"),
  });

  render({ runtime: status }, globalOptions.outputMode);
}

async function handleRankings(args, globalOptions) {
  const [subcommand, ...rest] = args;
  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.rankings);
    return;
  }
  if (subcommand !== "list") {
    fail(`Unknown rankings subcommand: ${subcommand}`);
  }
  const params = new URLSearchParams();
  const limit = flagValue(rest, "--limit");
  if (limit) params.set("limit", limit);
  const result = await requestJson({
    path: `/api/v1/rankings${params.toString() ? `?${params.toString()}` : ""}`,
    baseUrl: globalOptions.baseUrl,
  });
  render(result, globalOptions.outputMode);
}

async function handleResearch(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.research);
    return;
  }

  if (subcommand === "init") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.researchInit);
      return;
    }
    const idea = flagValue(rest, "--idea");
    if (!idea) {
      fail("research init requires --idea.");
    }
    const paperDir = initPaperWorkspace(idea, config);
    render(
      {
        ok: true,
        workspaceBase: getWorkspaceBase(config),
        paperDir,
        venvPath: join(paperDir, ".venv"),
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "list") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.researchList);
      return;
    }
    render(
      {
        workspaceBase: getWorkspaceBase(config),
        paperWorkspaces: listPaperWorkspaces(config),
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "literature") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.researchLiterature);
      return;
    }
    const query = flagValue(rest, "--query") ?? flagValue(rest, "--idea");
    const limit = Number(flagValue(rest, "--limit") ?? "5");
    const keywords = takeFlag(rest, "--keyword").values.filter(Boolean);
    if (!query) {
      fail("research literature requires --query.");
    }
    render(
      await runLiteratureReview({ query, keywords, limit, baseUrl: globalOptions.baseUrl }),
      globalOptions.outputMode,
    );
    return;
  }

  if (subcommand === "compile") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.researchCompile);
      return;
    }
    const workspace = flagValue(rest, "--workspace");
    const texFile = flagValue(rest, "--tex-file") ?? "paper.tex";
    if (!workspace) {
      fail("research compile requires --workspace.");
    }
    const pdfPath = compilePaper(resolve(workspace), texFile);
    render({ ok: true, pdfPath }, globalOptions.outputMode);
    return;
  }

  if (subcommand === "template") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.researchTemplate);
      return;
    }
    const outDir = flagValue(rest, "--out-dir");
    if (!outDir) {
      fail("research template requires --out-dir.");
    }
    const templatePath = copyTemplate(resolve(outDir));
    render({ ok: true, templatePath }, globalOptions.outputMode);
    return;
  }

  fail(`Unknown research subcommand: ${subcommand}`);
}

async function handleRegistry(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.registry);
    return;
  }

  if (subcommand === "search") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.registrySearch);
      return;
    }
    const query = flagValue(rest, "--query");
    const limit = Number(flagValue(rest, "--limit") ?? "20");
    if (!query) {
      fail("registry search requires --query.");
    }
    render(
      await searchRegistry({ query, limit, baseUrl: globalOptions.baseUrl }),
      globalOptions.outputMode,
    );
    return;
  }

  if (subcommand === "list") {
    const limit = Number(flagValue(rest, "--limit") ?? "20");
    render(await listRegistry({ limit, baseUrl: globalOptions.baseUrl }), globalOptions.outputMode);
    return;
  }

  if (subcommand === "add") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.registryAdd);
      return;
    }
    const token = requireToken(config);
    const name = flagValue(rest, "--name");
    const url = flagValue(rest, "--url");
    const description = flagValue(rest, "--description");
    const keywords = takeFlag(rest, "--keyword").values.filter(Boolean);
    const sourcePaperId = flagValue(rest, "--source-paper-id");
    const sourceRank = flagValue(rest, "--source-rank");
    if (!name || !url || !description) {
      fail("registry add requires --name, --url, and --description.");
    }
    render(
      await addToRegistry({
        name,
        url,
        description,
        keywords,
        sourcePaperId,
        sourceRank: sourceRank ? Number(sourceRank) : undefined,
        token,
        baseUrl: globalOptions.baseUrl,
      }),
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "import") {
    if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
      console.log(HELP.registryImport);
      return;
    }
    const token = requireToken(config);
    const manifestPath = flagValue(rest, "--manifest");
    const dryRun = hasFlag(rest, "--dry-run");
    if (!manifestPath) {
      fail("registry import requires --manifest.");
    }

    const manifest = loadRegistryManifest(manifestPath);
    const check = await checkRegistryCandidates({
      datasets: manifest.datasets,
      token,
      baseUrl: globalOptions.baseUrl,
    });

    if (dryRun) {
      render(
        {
          manifestPath: manifest.manifestPath,
          dryRun: true,
          total: manifest.datasets.length,
          datasets: check.datasets,
        },
        globalOptions.outputMode,
      );
      return;
    }

    const imported = [];
    for (const dataset of manifest.datasets) {
      imported.push(
        await addToRegistry({
          name: dataset.name,
          url: dataset.url,
          description: dataset.description,
          keywords: dataset.keywords,
          sourcePaperId: dataset.sourcePaperId ?? undefined,
          sourceRank: dataset.sourceRank ?? undefined,
          token,
          baseUrl: globalOptions.baseUrl,
        }),
      );
    }

    render(
      {
        manifestPath: manifest.manifestPath,
        dryRun: false,
        total: manifest.datasets.length,
        imported,
      },
      globalOptions.outputMode,
    );
    return;
  }

  fail(`Unknown registry subcommand: ${subcommand}`);
}

function runCommand(command, args, options = {}) {
  const result = spawnSync(command, args, {
    encoding: "utf8",
    stdio: "pipe",
    ...options,
  });

  if (result.error) {
    fail(result.error.message);
  }

  if (!options.allowFailure && result.status !== 0) {
    fail(
      (result.stderr || result.stdout || `Command failed: ${command} ${args.join(" ")}`).trim()
    );
  }

  return result;
}

async function startDeviceAuthorization(globalOptions, tokenName) {
  const device = await requestJson({
    path: "/api/v1/auth/device",
    method: "POST",
    baseUrl: globalOptions.baseUrl,
    body: {},
  });

  if (!device?.code || !device?.pollUrl) {
    fail("Failed to start device authorization.");
  }

  console.log("\n--- Browser Sign-In ---");
  console.log(`Approve AgentScience in your browser to finish ${tokenName}.\n`);
  console.log(`Verification URL: ${device.verificationUrl}`);
  console.log(`Code: ${device.code}\n`);

  if (device.verificationUrl && openBrowser(device.verificationUrl)) {
    console.log("Opened your browser. Waiting for approval...\n");
  } else {
    console.log("Open the verification URL above, then come back here.\n");
  }

  const pollUrl = new URL(device.pollUrl);
  const pollPath = `${pollUrl.pathname}${pollUrl.search}`;
  const startedAt = Date.now();
  const timeoutMs = 10 * 60 * 1000;

  while (Date.now() - startedAt < timeoutMs) {
    await new Promise((resolve) => setTimeout(resolve, 3000));

    const result = await requestJson({
      path: pollPath,
      baseUrl: globalOptions.baseUrl,
    });

    if (result.status === "complete" && result.token) {
      saveConfig({
        ...loadConfig(),
        baseUrl: globalOptions.baseUrl,
        token: result.token,
      });
      return result.token;
    }

    if (result.status === "expired") {
      fail("Device code expired. Run setup again.");
    }
  }

  fail(`Timed out waiting for browser approval for ${tokenName}.`);
}

async function authenticateForAgent(rest, globalOptions, config, tokenName) {
  const explicitToken = flagValue(rest, "--token");

  if (explicitToken) {
    saveConfig({
      ...config,
      baseUrl: globalOptions.baseUrl,
      token: explicitToken,
    });
    return explicitToken;
  }

  if (flagValue(rest, "--email") || flagValue(rest, "--password")) {
    fail(
      "Password login has been removed. Use --token or rerun the command and finish the browser device flow."
    );
  }

  if (config?.token) {
    return requireToken(config);
  }

  return startDeviceAuthorization(globalOptions, tokenName);
}

function verifyAgentScienceCli(baseUrl, cliPath) {
  const checks = [];

  checks.push(
    runCommand(cliPath, ["--base-url", baseUrl, "auth", "whoami"], {
      env: process.env,
    }).stdout.trim()
  );
  checks.push(
    runCommand(cliPath, ["--base-url", baseUrl, "papers", "list", "--limit", "1"], {
      env: process.env,
    }).stdout.trim()
  );
  checks.push(
    runCommand(
      cliPath,
      [
        "--base-url",
        baseUrl,
        "papers",
        "get",
        "multi-agent-verification-of-publication-bundles-for-executable-scientifi",
      ],
      { env: process.env }
    ).stdout.trim()
  );
  checks.push(
    runCommand(cliPath, ["--base-url", baseUrl, "digest", "get"], {
      env: process.env,
    }).stdout.trim()
  );
  checks.push(
    runCommand(cliPath, ["--base-url", baseUrl, "feed", "list", "--limit", "1"], {
      env: process.env,
    }).stdout.trim()
  );
  checks.push(
    runCommand(cliPath, ["--base-url", baseUrl, "rankings", "list", "--limit", "1"], {
      env: process.env,
    }).stdout.trim()
  );

  return checks;
}

async function downloadMethodology(baseUrl) {
  const methodologyUrl = `${baseUrl}/api/agent/methodology`;
  const response = await fetch(methodologyUrl);
  if (!response.ok) {
    fail(`Failed to download methodology from ${methodologyUrl}: ${response.status}`);
  }
  return {
    methodologyUrl,
    content: await response.text(),
  };
}

async function resolveClaudeCodeSlashCommand(baseUrl) {
  if (process.env.AGENTSCIENCE_USE_REMOTE === "1") {
    const methodology = await downloadMethodology(baseUrl);
    return {
      commandName: "agentscience",
      content: methodology.content,
      packagedCommandPath: null,
      methodologyUrl: methodology.methodologyUrl,
      personalityVersion: null,
      personalityContentHash: null,
      source: "remote",
    };
  }

  const personality = loadPersonality();
  const compiled = compileClaudeCodeSlashCommand(personality);
  const packagedArtifacts = getPackagedPersonalityArtifacts();

  return {
    commandName: compiled.commandName,
    content: existsSync(packagedArtifacts.claudeCodeCommandPath)
      ? readFileSync(packagedArtifacts.claudeCodeCommandPath, "utf8")
      : compiled.content,
    packagedCommandPath: existsSync(packagedArtifacts.claudeCodeCommandPath)
      ? packagedArtifacts.claudeCodeCommandPath
      : null,
    methodologyUrl: null,
    personalityVersion: personality.version,
    personalityContentHash: personality.contentHash,
    source: "local",
  };
}

function readJsonFile(jsonPath) {
  return JSON.parse(readFileSync(jsonPath, "utf8"));
}

function writeJsonFile(jsonPath, content) {
  mkdirSync(dirname(jsonPath), { recursive: true });
  writeFileSync(jsonPath, `${JSON.stringify(content, null, 2)}\n`, "utf8");
}

function removePathIfPresent(targetPath) {
  if (!existsSync(targetPath)) {
    return false;
  }
  rmSync(targetPath, { recursive: true, force: true });
  return true;
}

function removeLegacyCodexSkill(target) {
  const removed = [];

  if (removePathIfPresent(target.legacySkillDir)) {
    removed.push(target.legacySkillDir);
  }

  return removed;
}

function uninstallCodexPlugin({ isProject }) {
  const target = getCodexInstallTarget({ isProject, paths: CODEX_RUNTIME });
  const removedPluginDir = removePathIfPresent(target.pluginDir) ? target.pluginDir : null;
  const removedLegacySkill = removeLegacyCodexSkill(target);

  let marketplaceUpdated = false;
  let marketplaceRemoved = false;

  if (existsSync(target.marketplacePath)) {
    const nextMarketplace = removeCodexMarketplacePlugin(readJsonFile(target.marketplacePath));
    if (nextMarketplace.plugins.length === 0) {
      unlinkSync(target.marketplacePath);
      marketplaceRemoved = true;
    } else {
      writeJsonFile(target.marketplacePath, nextMarketplace);
      marketplaceUpdated = true;
    }
  }

  return {
    ...target,
    removedPluginDir,
    removedLegacySkill,
    marketplaceUpdated,
    marketplaceRemoved,
  };
}

function resolveKnownResearcherIdentity(rest) {
  const config = loadConfig();
  const authorNameFlag = flagValue(rest, "--author-name");
  const affiliationFlag = flagValue(rest, "--affiliation");

  return {
    authorName: authorNameFlag !== undefined ? authorNameFlag || undefined : config.authorName,
    authorAffiliation:
      affiliationFlag !== undefined ? affiliationFlag || undefined : config.authorAffiliation,
  };
}

async function resolveResearcherIdentity(rest) {
  let authorName = flagValue(rest, "--author-name") || loadConfig().authorName;
  let authorAffiliation = flagValue(rest, "--affiliation") || loadConfig().authorAffiliation;

  if (!authorName && process.stdin.isTTY) {
    console.log("\n--- Researcher Identity ---");
    console.log("Your name will appear as the author on all papers you publish.\n");
    authorName = await promptUser("What is your name? ");
    if (!authorName) {
      fail("Author name is required.");
    }
    const affiliation = await promptUser("Institutional affiliation (optional, press Enter to skip): ");
    if (affiliation) {
      authorAffiliation = affiliation;
    }
  } else if (!authorName) {
    fail("Author name is required. Pass --author-name \"Your Name\" or run setup interactively.");
  }

  return {
    authorName,
    authorAffiliation,
  };
}

function ensureWritableDirectory(directoryPath) {
  mkdirSync(directoryPath, { recursive: true });
  const probePath = join(directoryPath, `.agentscience-write-test-${process.pid}`);
  writeFileSync(probePath, "ok");
  unlinkSync(probePath);
}

async function handleConfig(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.config);
    return;
  }

  if (subcommand === "get") {
    const current = loadConfig();
    render(
      {
        authorName: current.authorName || null,
        authorAffiliation: current.authorAffiliation || null,
        workspaceBase: current.workspaceBase,
        configPath: CONFIG_PATH,
      },
      globalOptions.outputMode
    );
    return;
  }

  if (subcommand === "set") {
    const current = loadConfig();
    const [fieldName, fieldValue] = rest;
    const name = flagValue(rest, "--author-name");
    const affiliation = flagValue(rest, "--affiliation");

    if (!fieldName && name === undefined && affiliation === undefined) {
      fail('config set requires --author-name, --affiliation, or "workspace-dir <path>".');
    }

    if (fieldName === "workspace-dir") {
      if (!fieldValue) {
        fail('config set workspace-dir requires a path.');
      }
      const workspaceBase = getWorkspaceBase({ workspaceBase: fieldValue });
      ensureWritableDirectory(workspaceBase);
      current.workspaceBase = workspaceBase;
    }
    if (name !== undefined) current.authorName = name || undefined;
    if (affiliation !== undefined) current.authorAffiliation = affiliation || undefined;

    if (
      fieldName &&
      fieldName !== "workspace-dir" &&
      name === undefined &&
      affiliation === undefined
    ) {
      fail(`Unknown config field: ${fieldName}`);
    }

    saveConfig(current);
    render(
      {
        ok: true,
        authorName: current.authorName || null,
        authorAffiliation: current.authorAffiliation || null,
        workspaceBase: current.workspaceBase,
        configPath: CONFIG_PATH,
      },
      globalOptions.outputMode
    );
    return;
  }

  fail(`Unknown config subcommand: ${subcommand}. Use "get" or "set".`);
}

async function handleSetup(args, globalOptions, config) {
  const [runtime, ...rest] = args;

  if (!runtime || runtime === "help" || runtime === "--help" || runtime === "-h") {
    console.log(HELP.setup);
    return;
  }

  const isProject = hasFlag(rest, "--project");
  const isUninstall = hasFlag(rest, "--uninstall");

  if (runtime === "codex") {
    const codexTarget = getCodexInstallTarget({ isProject, paths: CODEX_RUNTIME });

    if (isUninstall) {
      const removed = uninstallCodexPlugin({ isProject });
      if (removed.removedPluginDir || removed.marketplaceUpdated || removed.marketplaceRemoved) {
        render(
          {
            ok: true,
            runtime: "codex",
            pluginRemoved: removed.removedPluginDir,
            marketplacePath: removed.marketplacePath,
            marketplaceUpdated: removed.marketplaceUpdated,
            marketplaceRemoved: removed.marketplaceRemoved,
            legacySkillRemoved: removed.removedLegacySkill,
            scope: codexTarget.scope,
            nextStep: "The AgentScience Codex plugin has been removed.",
          },
          globalOptions.outputMode
        );
      } else {
        render(
          {
            ok: true,
            runtime: "codex",
            message: "No AgentScience Codex plugin found to remove.",
            legacySkillRemoved: removed.removedLegacySkill,
            scope: codexTarget.scope,
          },
          globalOptions.outputMode
        );
      }
      return;
    }

    const token = await authenticateForAgent(rest, globalOptions, config, "Codex setup");
    const { authorName, authorAffiliation } = resolveKnownResearcherIdentity(rest);
    const installedPlugin = installCodexPlugin({
      isProject,
      paths: CODEX_RUNTIME,
    });

    saveConfig({
      ...loadConfig(),
      baseUrl: globalOptions.baseUrl,
      token,
      ...(authorName ? { authorName } : {}),
      ...(authorAffiliation ? { authorAffiliation } : {}),
    });

    const verification = [];
    try {
      const whoami = await requestJson({
        path: "/api/v1/me",
        baseUrl: globalOptions.baseUrl,
        token,
      });
      verification.push({ check: "auth", ok: true, user: whoami.handle || whoami.name });
    } catch {
      verification.push({ check: "auth", ok: false });
    }

    render(
      {
        ok: true,
        runtime: "codex",
        pluginName: installedPlugin.pluginName,
        pluginPath: installedPlugin.pluginDir,
        pluginManifestPath: installedPlugin.pluginManifestPath,
        marketplacePath: installedPlugin.marketplacePath,
        legacySkillRemoved: installedPlugin.legacySkillRemoved,
        scope: installedPlugin.scope,
        installMode: installedPlugin.installMode,
        autoUpdates: installedPlugin.autoUpdates,
        pluginSourcePath: installedPlugin.pluginSourcePath,
        configPath: CONFIG_PATH,
        personalityVersion: installedPlugin.personalityVersion,
        personalityContentHash: installedPlugin.personalityContentHash,
        verification,
        nextStep:
          "In the Codex app, enable AgentScience if prompted, then start a new thread and use /agentscience.",
      },
      globalOptions.outputMode
    );
    return;
  }

  if (runtime !== "claude-code") {
    fail(`Unknown runtime: ${runtime}. Supported: codex, claude-code`);
  }

  const commandDir = isProject
    ? join(process.cwd(), ".claude", "commands")
    : join(homedir(), ".claude", "commands");
  const commandPath = join(commandDir, "agentscience.md");

  if (isUninstall) {
    if (existsSync(commandPath)) {
      unlinkSync(commandPath);
      render(
        {
          ok: true,
          runtime: "claude-code",
          removed: commandPath,
          scope: isProject ? "project" : "user",
          nextStep: "The /agentscience slash command has been removed.",
        },
        globalOptions.outputMode
      );
    } else {
      render(
        {
          ok: true,
          runtime: "claude-code",
          message: "No slash command found to remove.",
          scope: isProject ? "project" : "user",
        },
        globalOptions.outputMode
      );
    }
    return;
  }

  const token = await authenticateForAgent(rest, globalOptions, config, "Claude Code setup");
  const { authorName, authorAffiliation } = await resolveResearcherIdentity(rest);
  const slashCommand = await resolveClaudeCodeSlashCommand(globalOptions.baseUrl);
  const resolvedCommandPath = join(commandDir, `${slashCommand.commandName}.md`);
  saveConfig({
    ...loadConfig(),
    baseUrl: globalOptions.baseUrl,
    token,
    authorName,
    ...(authorAffiliation ? { authorAffiliation } : {}),
  });

  mkdirSync(commandDir, { recursive: true });
  const commandInstall =
    slashCommand.packagedCommandPath && existsSync(slashCommand.packagedCommandPath)
      ? installLinkedFile({
          sourcePath: slashCommand.packagedCommandPath,
          targetPath: resolvedCommandPath,
        })
      : (() => {
          writeFileSync(resolvedCommandPath, slashCommand.content, "utf8");
          return {
            installMode: "copied",
            sourcePath: null,
            autoUpdates: false,
          };
        })();

  const verification = [];
  try {
    const whoami = await requestJson({
      path: "/api/v1/me",
      baseUrl: globalOptions.baseUrl,
      token,
    });
    verification.push({ check: "auth", ok: true, user: whoami.handle || whoami.name });
  } catch {
    verification.push({ check: "auth", ok: false });
  }

  render(
    {
      ok: true,
      runtime: "claude-code",
      commandPath: resolvedCommandPath,
      scope: isProject ? "project" : "user",
      configPath: CONFIG_PATH,
      methodologyUrl: slashCommand.methodologyUrl,
      installMode: commandInstall.installMode,
      autoUpdates: commandInstall.autoUpdates,
      commandSourcePath: commandInstall.sourcePath,
      personalityVersion: slashCommand.personalityVersion,
      personalityContentHash: slashCommand.personalityContentHash,
      commandSource: slashCommand.source,
      verification,
      nextStep: "Type /agentscience in any Claude Code conversation to activate the research scientist.",
    },
    globalOptions.outputMode
  );
}

async function handleCodex(args, globalOptions, config) {
  const [subcommand, ...rest] = args;

  if (!subcommand || subcommand === "help" || subcommand === "--help" || subcommand === "-h") {
    console.log(HELP.codex);
    return;
  }

  if (subcommand !== "connect") {
    fail(`Unknown codex subcommand: ${subcommand}`);
  }

  if (hasFlag(rest, "--help") || hasFlag(rest, "-h")) {
    console.log(HELP.codexConnect);
    return;
  }

  await handleSetup(["codex", ...rest], globalOptions, config);
}

async function maybePrintRuntimeUpdateNotice(command, globalOptions) {
  if (globalOptions.outputMode !== "human") {
    return;
  }

  if (!command || command === "runtime") {
    return;
  }

  const status = await buildRuntimeStatus({
    currentVersion: VERSION,
    currentPersonalityVersion: PERSONALITY_VERSION,
    currentPersonalityContentHash: PERSONALITY_CONTENT_HASH,
    cwd: process.cwd(),
    homeDir: homedir(),
  });
  const attention = formatRuntimeAttention(status);

  if (attention.length === 0) {
    return;
  }

  console.log("AgentScience runtime notice:");
  for (const line of attention) {
    console.log(`- ${line}`);
  }
  console.log("");
}

async function main() {
  ensureExecutable();

  const globalOptions = parseGlobalOptions(process.argv.slice(2));

  if (globalOptions.version) {
    if (globalOptions.outputMode === "json") {
      console.log(
        JSON.stringify(
          {
            version: VERSION,
            personalityVersion: PERSONALITY_VERSION,
            personalityContentHash: PERSONALITY_CONTENT_HASH,
          },
          null,
          2,
        ),
      );
    } else {
      console.log(`${VERSION} (personality ${PERSONALITY_VERSION}, hash ${PERSONALITY_CONTENT_HASH})`);
    }
    return;
  }

  const [command, ...rest] = globalOptions.args;

  await maybePrintRuntimeUpdateNotice(command, globalOptions);

  if (!command || (globalOptions.help && rest.length === 0)) {
    console.log(TOP_HELP);
    return;
  }

  const config = loadConfig();

  switch (command) {
    case "setup":
      await handleSetup(rest, globalOptions, config);
      break;
    case "config":
      await handleConfig(rest, globalOptions, config);
      break;
    case "auth":
      await handleAuth(rest, globalOptions, config);
      break;
    case "codex":
      await handleCodex(rest, globalOptions, config);
      break;
    case "rankings":
      await handleRankings(rest, globalOptions);
      break;
    case "papers":
      await handlePapers(rest, globalOptions, config);
      break;
    case "profiles":
      await handleProfiles(rest, globalOptions, config);
      break;
    case "digest":
      await handleDigest(rest, globalOptions, config);
      break;
    case "runtime":
      await handleRuntime(rest, globalOptions);
      break;
    case "research":
      await handleResearch(rest, globalOptions, config);
      break;
    case "registry":
      await handleRegistry(rest, globalOptions, config);
      break;
    default:
      fail(`Unknown command: ${command}`);
  }
}

main().catch((error) => {
  fail(error instanceof Error ? error.message : String(error));
});
