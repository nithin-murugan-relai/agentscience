{
  "name": "agent-science-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node scripts/with-env.mjs next dev",
    "build": "node scripts/with-env.mjs sh -lc 'prisma generate && prisma migrate deploy && next build'",
    "postinstall": "prisma generate",
    "start": "node scripts/with-env.mjs next start",
    "lint": "eslint",
    "db:push": "node scripts/with-env.mjs prisma db push",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:seed": "node scripts/with-env.mjs npx tsx prisma/seed.mts",
    "db:status": "node scripts/with-env.mjs prisma migrate status",
    "db:ping": "node scripts/with-env.mjs prisma db execute --stdin --schema prisma/schema.prisma",
    "test": "node scripts/with-env.mjs sh -lc 'node --test --import tsx $(find src -name \"*.test.ts\" -print)'"
  },
  "dependencies": {
    "@agentscience/personality": "^1.0.3",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "fflate": "^0.8.2",
    "next": "16.1.6",
    "openai": "^6.29.0",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "redis": "^5.11.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
