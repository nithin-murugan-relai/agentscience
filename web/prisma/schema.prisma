generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  RESEARCHER
  LAB
  BOT
  ADMIN
}

enum PaperOrigin {
  MANUAL
  SIDEKICK
  IMPORT
}

enum PaperVisibility {
  PUBLIC
  UNLISTED
}

enum ReviewKind {
  HUMAN
  AI
}

enum ReviewVerdict {
  ENDORSE
  CONCERN
}

enum MetricStatus {
  PENDING
  READY
  DISABLED
  FAILED
}

enum PaperAssetKind {
  FIGURE
  DATA
  SUPPLEMENT
}

enum PaperArtifactKind {
  ANALYSIS_CODE
  FIGURE_CODE
  DATA_PROCESSING_CODE
  DATA
  DOCUMENTATION
  LATEX_SOURCE
  BIBLIOGRAPHY
  PDF
  OTHER
}

enum SidekickPaperStatus {
  ACTIVE
  BURIED
  FLAGGED
}

enum SidekickEngagementType {
  BUILD
  REPRODUCE
  CHALLENGE
}

enum SidekickReproductionResult {
  CONFIRMED
  PARTIALLY_CONFIRMED
  CONTRADICTED
  INCONCLUSIVE
}

enum SidekickReviewTrigger {
  TOP_50
  ENGAGEMENT_THRESHOLD
  FAILED_REPRODUCTION
  ENGAGEMENT_SPIKE
}

enum SidekickReputationEventType {
  PAPER_PASSED_INTEGRITY
  PAPER_BURIED_INTEGRITY
  BUILD_RECEIVED
  REPRODUCTION_CONFIRMED_RECEIVED
  REPRODUCTION_CONTRADICTED_RECEIVED
  PAPER_SURVIVED_REVIEW
  PAPER_FAILED_REVIEW
  SUBSTANTIVE_CHALLENGE_POSTED
  REPRODUCTION_CONFIRMED_POSTED
}

model User {
  id                  String           @id @default(cuid())
  name                String
  handle              String           @unique
  email               String           @unique
  passwordHash        String
  bio                 String?
  institution         String?
  role                UserRole         @default(RESEARCHER)
  researchInterests   String[]         @default([])
  digestEnabled       Boolean          @default(true)
  digestEmailEnabled  Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sessions            Session[]
  authoredPapers      PaperAuthor[]
  ideas               Idea[]
  reviews             Review[]         @relation("UserReviews")
  saves               SavedPaper[]
  integrationKeys IntegrationKey[]
  deviceCodes         DeviceCode[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Paper {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  abstract       String
  markdown       String
  latexSource    String?
  bibSource      String?
  pdfUrl         String?
  pdfData        Bytes?
  pdfMimeType    String?
  pdfFileName    String?
  canonicalUrl   String?
  githubUrl      String?
  doi            String?           @unique
  externalId     String?           @unique
  origin         PaperOrigin       @default(MANUAL)
  visibility     PaperVisibility   @default(PUBLIC)
  keywords       String[]          @default([])
  sourceNoteIds  String[]          @default([])
  metadata       Json?
  publishedAt    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  authors        PaperAuthor[]
  ideas          Idea[]
  reviews        Review[]          @relation("PaperReviews")
  saves          SavedPaper[]
  referencesOut  PaperReference[]  @relation("OutgoingReferences")
  referencesIn   PaperReference[]  @relation("IncomingReferences")
  assets         PaperAsset[]
  artifacts      PaperArtifact[]
  metric         PaperMetric?

  @@index([publishedAt])
  @@index([origin])
}

model PaperAuthor {
  id             String   @id @default(cuid())
  paperId        String
  userId         String
  position       Int
  affiliation    String?
  isCorresponding Boolean @default(false)
  paper          Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
  @@unique([paperId, position])
}

model Idea {
  id           String   @id @default(cuid())
  content      String
  summary      String?
  researchPlan Json?
  authorId     String
  paperId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  paper        Paper?   @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([paperId])
  @@index([paperId, authorId])
}

model Review {
  id              String        @id @default(cuid())
  paperId         String
  reviewerId      String?
  reviewerName    String?
  kind            ReviewKind    @default(HUMAN)
  verdict         ReviewVerdict @default(ENDORSE)
  summary         String
  novelty         Int?
  rigor           Int?
  clarity         Int?
  reproducibility Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paper           Paper         @relation("PaperReviews", fields: [paperId], references: [id], onDelete: Cascade)
  reviewer        User?         @relation("UserReviews", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([paperId, kind])
  @@index([paperId, reviewerId, kind])
}

model SavedPaper {
  id        String   @id @default(cuid())
  paperId   String
  userId    String
  createdAt DateTime @default(now())
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
}

model PaperReference {
  id             String   @id @default(cuid())
  sourcePaperId  String
  targetPaperId  String?
  referenceTitle String?
  referenceDoi   String?
  confidence     Float    @default(1)
  kind           String   @default("citation")
  createdAt      DateTime @default(now())
  sourcePaper    Paper    @relation("OutgoingReferences", fields: [sourcePaperId], references: [id], onDelete: Cascade)
  targetPaper    Paper?   @relation("IncomingReferences", fields: [targetPaperId], references: [id], onDelete: SetNull)

  @@index([sourcePaperId])
  @@index([targetPaperId])
}

model PaperMetric {
  paperId      String       @id
  humanScore   Float        @default(0)
  networkScore Float        @default(0)
  aiScore      Float?
  finalScore   Float        @default(0)
  aiStatus     MetricStatus @default(PENDING)
  aiSummary    String?
  reviewCount  Int          @default(0)
  saveCount    Int          @default(0)
  ideaCount    Int          @default(0)
  updatedAt    DateTime     @updatedAt
  paper        Paper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
}

model IntegrationKey {
  id         String   @id @default(cuid())
  userId     String
  name       String
  tokenPrefix String
  tokenHash  String   @unique
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PaperAsset {
  id         String         @id @default(cuid())
  paperId     String
  kind        PaperAssetKind
  fileName    String
  mimeType    String
  caption     String?
  textContent String?
  bytes       Bytes?
  sizeBytes   Int?
  createdAt   DateTime       @default(now())
  paper       Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, kind])
  @@unique([paperId, fileName])
}

model PaperArtifact {
  id          String            @id @default(cuid())
  paperId      String
  kind         PaperArtifactKind
  path         String
  fileName     String
  contentType  String
  sha256       String
  textContent  String?
  bytes        Bytes?
  sizeBytes    Int
  createdAt    DateTime          @default(now())
  paper        Paper             @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, kind])
  @@unique([paperId, path])
}

model DeviceCode {
  id        String   @id @default(cuid())
  code      String   @unique
  token     String?
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  namespace   String
  subject     String
  windowStart DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([namespace, subject, windowStart])
  @@index([updatedAt])
}

model SidekickAgent {
  id               String                    @id @default(uuid())
  name             String                    @unique
  reputationScore  Float                     @default(0)
  totalPapers      Int                       @default(0)
  createdAt        DateTime                  @default(now())
  papers           SidekickPaper[]
  engagements      SidekickEngagement[]
  reputationEvents SidekickReputationEvent[] @relation("AgentReputationEvents")
}

model SidekickPaper {
  id                  String                       @id @default(uuid())
  agentId             String
  title               String
  fullContent         String
  claim1              String
  claim2              String
  claim3              String
  methodology         String
  noveltyStatement    String
  fieldTags           String[]                     @default([])
  refValidityRate     Float                        @default(0)
  specificityScore    Float                        @default(0)
  engagementSignal    Float                        @default(1)
  feedScore           Float                        @default(0)
  status              SidekickPaperStatus          @default(BURIED)
  adversarialSurvival Float?
  createdAt           DateTime                     @default(now())
  agent               SidekickAgent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  references          SidekickReference[]
  engagements         SidekickEngagement[]         @relation("TargetPaperEngagements")
  buildingEngagements SidekickEngagement[]         @relation("BuildingPaperEngagements")
  adversarialReviews  SidekickAdversarialReview[]
  signalEvents        SidekickSignalEvent[]
  reputationEvents    SidekickReputationEvent[]    @relation("PaperReputationEvents")

  @@index([feedScore(sort: Desc)])
  @@index([agentId])
  @@index([status])
}

model SidekickReference {
  id        String        @id @default(uuid())
  paperId   String
  title     String
  authors   String
  doi       String?
  year      Int
  validated Boolean       @default(false)
  paper     SidekickPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
}

model SidekickEngagement {
  id               String                      @id @default(uuid())
  paperId          String
  agentId          String
  type             SidekickEngagementType
  targetClaim      Int?
  buildingPaperId  String?
  result           SidekickReproductionResult?
  content          String
  substantiveness  Float                       @default(0)
  weight           Float                       @default(0)
  createdAt        DateTime                    @default(now())
  paper            SidekickPaper               @relation("TargetPaperEngagements", fields: [paperId], references: [id], onDelete: Cascade)
  agent            SidekickAgent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  buildingPaper    SidekickPaper?              @relation("BuildingPaperEngagements", fields: [buildingPaperId], references: [id], onDelete: SetNull)
  reputationEvents SidekickReputationEvent[]   @relation("EngagementReputationEvents")

  @@index([paperId])
  @@index([agentId])
  @@unique([paperId, agentId, type, buildingPaperId])
  @@unique([paperId, agentId, type, targetClaim])
}

model SidekickAdversarialReview {
  id               String                     @id @default(uuid())
  paperId          String
  survivalScore    Float
  findings         Json
  triggerReason    SidekickReviewTrigger
  createdAt        DateTime                   @default(now())
  paper            SidekickPaper              @relation(fields: [paperId], references: [id], onDelete: Cascade)
  reputationEvents SidekickReputationEvent[]  @relation("ReviewReputationEvents")

  @@index([paperId, createdAt])
}

model SidekickReputationEvent {
  id           String                     @id @default(uuid())
  agentId      String
  paperId      String?
  engagementId String?
  reviewId     String?
  type         SidekickReputationEventType
  points       Float
  metadata     Json?
  createdAt    DateTime                   @default(now())
  agent        SidekickAgent              @relation("AgentReputationEvents", fields: [agentId], references: [id], onDelete: Cascade)
  paper        SidekickPaper?             @relation("PaperReputationEvents", fields: [paperId], references: [id], onDelete: SetNull)
  engagement   SidekickEngagement?        @relation("EngagementReputationEvents", fields: [engagementId], references: [id], onDelete: SetNull)
  review       SidekickAdversarialReview? @relation("ReviewReputationEvents", fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
}

model SidekickSignalEvent {
  id        String        @id @default(uuid())
  paperId    String
  delta      Float
  reason     String
  createdAt  DateTime      @default(now())
  paper      SidekickPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, createdAt])
}

enum DatasetProviderSearchKind {
  GRAPHQL
  REST
  HTML
}

/// A discovery surface that catalogs many datasets (OpenNeuro, HuggingFace, etc.).
/// Providers carry the recipe an agent needs to search inside them; without this
/// row the registry cannot tell an agent *how* to query the catalog.
model DatasetProvider {
  id                  String                     @id @default(cuid())
  slug                String                     @unique
  name                String
  homeUrl             String
  domain              String                     @unique
  description         String
  logoUrl             String?
  searchKind          DatasetProviderSearchKind?
  searchEndpoint      String?
  searchQueryTemplate String?
  datasetUrlTemplate  String?
  agentInstructions   String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  datasets            DatasetEntry[]

  @@index([domain])
}

model DatasetEntry {
  id          String   @id @default(cuid())
  name        String
  shortName   String?
  url         String
  domain      String
  description String
  keywords    String[] @default([])
  sourcePaperId String?
  sourceRank    Float?
  addedBy       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerId String?
  provider   DatasetProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([domain])
  @@index([sourceRank(sort: Desc)])
  @@index([providerId])
}
