generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  RESEARCHER
  LAB
  BOT
  ADMIN
}

enum PaperOrigin {
  MANUAL
  SIDEKICK
  IMPORT
}

enum PaperVisibility {
  PUBLIC
  UNLISTED
}

enum ReviewKind {
  HUMAN
  AI
}

enum ReviewVerdict {
  STRONG_ENDORSE
  ENDORSE
  MIXED
  CONCERN
}

enum MetricStatus {
  PENDING
  READY
  DISABLED
  FAILED
}

enum PaperAssetKind {
  FIGURE
  DATA
  SUPPLEMENT
}

model User {
  id                  String           @id @default(cuid())
  name                String
  handle              String           @unique
  email               String           @unique
  passwordHash        String
  bio                 String?
  institution         String?
  role                UserRole         @default(RESEARCHER)
  researchInterests   String[]         @default([])
  digestEnabled       Boolean          @default(true)
  digestEmailEnabled  Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sessions            Session[]
  authoredPapers      PaperAuthor[]
  ideas               Idea[]
  reviews             Review[]         @relation("UserReviews")
  saves               SavedPaper[]
  integrationKeys IntegrationKey[]
  comments            Comment[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Paper {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  abstract       String
  markdown       String
  latexSource    String?
  bibSource      String?
  pdfUrl         String?
  pdfData        Bytes?
  pdfMimeType    String?
  pdfFileName    String?
  canonicalUrl   String?
  githubUrl      String?
  doi            String?           @unique
  externalId     String?           @unique
  origin         PaperOrigin       @default(MANUAL)
  visibility     PaperVisibility   @default(PUBLIC)
  keywords       String[]          @default([])
  sourceNoteIds  String[]          @default([])
  metadata       Json?
  publishedAt    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  authors        PaperAuthor[]
  ideas          Idea[]
  reviews        Review[]          @relation("PaperReviews")
  comments       Comment[]
  saves          SavedPaper[]
  referencesOut  PaperReference[]  @relation("OutgoingReferences")
  referencesIn   PaperReference[]  @relation("IncomingReferences")
  assets         PaperAsset[]
  metric         PaperMetric?

  @@index([publishedAt])
  @@index([origin])
}

model PaperAuthor {
  id             String   @id @default(cuid())
  paperId        String
  userId         String
  position       Int
  affiliation    String?
  isCorresponding Boolean @default(false)
  paper          Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
  @@unique([paperId, position])
}

model Idea {
  id           String   @id @default(cuid())
  content      String
  summary      String?
  researchPlan Json?
  authorId     String
  paperId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  paper        Paper?   @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([paperId])
  @@index([paperId, authorId])
}

model Comment {
  id        String   @id @default(cuid())
  paperId    String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  paper      Paper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([paperId, createdAt])
  @@index([authorId, createdAt])
}

model Review {
  id              String        @id @default(cuid())
  paperId         String
  reviewerId      String?
  reviewerName    String?
  kind            ReviewKind    @default(HUMAN)
  verdict         ReviewVerdict @default(ENDORSE)
  summary         String
  strengths       String?
  concerns        String?
  novelty         Int
  rigor           Int
  clarity         Int
  reproducibility Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paper           Paper         @relation("PaperReviews", fields: [paperId], references: [id], onDelete: Cascade)
  reviewer        User?         @relation("UserReviews", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([paperId, kind])
  @@index([paperId, reviewerId, kind])
}

model SavedPaper {
  id        String   @id @default(cuid())
  paperId   String
  userId    String
  createdAt DateTime @default(now())
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
}

model PaperReference {
  id             String   @id @default(cuid())
  sourcePaperId  String
  targetPaperId  String?
  referenceTitle String?
  referenceDoi   String?
  confidence     Float    @default(1)
  kind           String   @default("citation")
  createdAt      DateTime @default(now())
  sourcePaper    Paper    @relation("OutgoingReferences", fields: [sourcePaperId], references: [id], onDelete: Cascade)
  targetPaper    Paper?   @relation("IncomingReferences", fields: [targetPaperId], references: [id], onDelete: SetNull)

  @@index([sourcePaperId])
  @@index([targetPaperId])
}

model PaperMetric {
  paperId      String       @id
  humanScore   Float        @default(0)
  networkScore Float        @default(0)
  aiScore      Float?
  finalScore   Float        @default(0)
  aiStatus     MetricStatus @default(PENDING)
  aiSummary    String?
  reviewCount  Int          @default(0)
  saveCount    Int          @default(0)
  ideaCount    Int          @default(0)
  updatedAt    DateTime     @updatedAt
  paper        Paper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
}

model IntegrationKey {
  id         String   @id @default(cuid())
  userId     String
  name       String
  tokenPrefix String
  tokenHash  String   @unique
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PaperAsset {
  id         String         @id @default(cuid())
  paperId     String
  kind        PaperAssetKind
  fileName    String
  mimeType    String
  caption     String?
  textContent String?
  bytes       Bytes?
  sizeBytes   Int?
  createdAt   DateTime       @default(now())
  paper       Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, kind])
  @@unique([paperId, fileName])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  namespace   String
  subject     String
  windowStart DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([namespace, subject, windowStart])
  @@index([updatedAt])
}
