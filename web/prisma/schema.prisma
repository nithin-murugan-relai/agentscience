generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  RESEARCHER
  LAB
  BOT
  ADMIN
}

enum PaperOrigin {
  MANUAL
  IMPORT
}

enum PaperVisibility {
  PUBLIC
  UNLISTED
}

enum ReviewKind {
  HUMAN
  AI
}

enum ReviewVerdict {
  ENDORSE
  CONCERN
}

enum MetricStatus {
  PENDING
  READY
  DISABLED
  FAILED
}

enum PaperAssetKind {
  FIGURE
  DATA
  SUPPLEMENT
}

enum PaperArtifactKind {
  ANALYSIS_CODE
  FIGURE_CODE
  DATA_PROCESSING_CODE
  DATA
  DOCUMENTATION
  LATEX_SOURCE
  BIBLIOGRAPHY
  PDF
  OTHER
}

model User {
  id                  String           @id @default(cuid())
  clerkId             String?          @unique
  name                String
  handle              String           @unique
  email               String?          @unique
  bio                 String?
  institution         String?
  role                UserRole         @default(RESEARCHER)
  researchInterests   String[]         @default([])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  authoredPapers      PaperAuthor[]
  ideas               Idea[]
  reviews             Review[]         @relation("UserReviews")
  saves               SavedPaper[]
  integrationKeys     IntegrationKey[]
  deviceCodes         DeviceCode[]
}

model Paper {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  abstract       String
  markdown       String
  latexSource    String?
  bibSource      String?
  pdfUrl         String?
  pdfData        Bytes?
  pdfMimeType    String?
  pdfFileName    String?
  canonicalUrl   String?
  githubUrl      String?
  doi            String?           @unique
  externalId     String?           @unique
  origin         PaperOrigin       @default(MANUAL)
  visibility     PaperVisibility   @default(PUBLIC)
  keywords       String[]          @default([])
  sourceNoteIds  String[]          @default([])
  metadata       Json?
  publishedAt    DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  authors        PaperAuthor[]
  ideas          Idea[]
  reviews        Review[]          @relation("PaperReviews")
  saves          SavedPaper[]
  referencesOut  PaperReference[]  @relation("OutgoingReferences")
  referencesIn   PaperReference[]  @relation("IncomingReferences")
  assets         PaperAsset[]
  artifacts      PaperArtifact[]
  metric         PaperMetric?

  @@index([publishedAt])
  @@index([origin])
}

model PaperAuthor {
  id             String   @id @default(cuid())
  paperId        String
  userId         String
  position       Int
  affiliation    String?
  isCorresponding Boolean @default(false)
  paper          Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
  @@unique([paperId, position])
}

model Idea {
  id           String   @id @default(cuid())
  content      String
  summary      String?
  researchPlan Json?
  authorId     String
  paperId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  paper        Paper?   @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([paperId])
  @@index([paperId, authorId])
}

model Review {
  id              String        @id @default(cuid())
  paperId         String
  reviewerId      String?
  reviewerName    String?
  kind            ReviewKind    @default(HUMAN)
  verdict         ReviewVerdict @default(ENDORSE)
  summary         String
  novelty         Int?
  rigor           Int?
  clarity         Int?
  reproducibility Int?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paper           Paper         @relation("PaperReviews", fields: [paperId], references: [id], onDelete: Cascade)
  reviewer        User?         @relation("UserReviews", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([paperId, kind])
  @@index([paperId, reviewerId, kind])
}

model SavedPaper {
  id        String   @id @default(cuid())
  paperId   String
  userId    String
  createdAt DateTime @default(now())
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
}

model PaperReference {
  id             String   @id @default(cuid())
  sourcePaperId  String
  targetPaperId  String?
  referenceTitle String?
  referenceDoi   String?
  confidence     Float    @default(1)
  kind           String   @default("citation")
  createdAt      DateTime @default(now())
  sourcePaper    Paper    @relation("OutgoingReferences", fields: [sourcePaperId], references: [id], onDelete: Cascade)
  targetPaper    Paper?   @relation("IncomingReferences", fields: [targetPaperId], references: [id], onDelete: SetNull)

  @@index([sourcePaperId])
  @@index([targetPaperId])
}

model PaperMetric {
  paperId      String       @id
  humanScore   Float        @default(0)
  networkScore Float        @default(0)
  aiScore      Float?
  integrityScore Float?
  finalScore   Float        @default(0)
  aiStatus     MetricStatus @default(PENDING)
  aiSummary    String?
  integritySummary String?
  reviewCount  Int          @default(0)
  saveCount    Int          @default(0)
  ideaCount    Int          @default(0)
  updatedAt    DateTime     @updatedAt
  paper        Paper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
}

model IntegrationKey {
  id         String   @id @default(cuid())
  userId     String
  name       String
  tokenPrefix String
  tokenHash  String   @unique
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PaperAsset {
  id         String         @id @default(cuid())
  paperId     String
  kind        PaperAssetKind
  fileName    String
  mimeType    String
  caption     String?
  textContent String?
  bytes       Bytes?
  sizeBytes   Int?
  createdAt   DateTime       @default(now())
  paper       Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, kind])
  @@unique([paperId, fileName])
}

model PaperArtifact {
  id          String            @id @default(cuid())
  paperId      String
  kind         PaperArtifactKind
  path         String
  fileName     String
  contentType  String
  sha256       String
  textContent  String?
  bytes        Bytes?
  sizeBytes    Int
  createdAt    DateTime          @default(now())
  paper        Paper             @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, kind])
  @@unique([paperId, path])
}

model DeviceCode {
  id        String   @id @default(cuid())
  code      String   @unique
  token     String?
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  namespace   String
  subject     String
  windowStart DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([namespace, subject, windowStart])
  @@index([updatedAt])
}

enum DatasetProviderSearchKind {
  GRAPHQL
  REST
  HTML
}

/// Closed, human-curated vocabulary for the top-level of the registry taxonomy.
/// Agents cannot invent new areas — this keeps the headline nav stable forever.
/// Topics carry the open-ish long tail beneath each area.
enum DatasetArea {
  LIFE_SCIENCES
  MEDICINE_HEALTH
  SOCIAL_SCIENCES
  PHYSICAL_SCIENCES
  EARTH_ENVIRONMENT
  COMPUTING_ENGINEERING
  MATH_STATISTICS
  HUMANITIES
  OTHER
}

/// Soft-close on topics: agents can propose new ones when registering a dataset,
/// but proposals land as PENDING and only ACTIVE topics appear in public surfaces
/// until an admin promotes them. This keeps the vocabulary from fragmenting into
/// synonyms while still feeding the registration flywheel.
enum DatasetTopicStatus {
  ACTIVE
  PENDING
}

/// Narrower-than-Area label that can be multi-tagged onto providers and datasets.
/// Each topic lives in exactly one area; cross-disciplinary coverage is expressed
/// by a provider or dataset wearing topics from multiple areas at once.
model DatasetTopic {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  area              DatasetArea
  description       String?
  agentInstructions String?
  status            DatasetTopicStatus @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  providers DatasetProvider[]
  datasets  DatasetEntry[]

  @@index([area])
  @@index([status])
}

/// A discovery surface that catalogs many datasets (OpenNeuro, HuggingFace, etc.).
/// Providers carry the recipe an agent needs to search inside them; without this
/// row the registry cannot tell an agent *how* to query the catalog.
model DatasetProvider {
  id                  String                     @id @default(cuid())
  slug                String                     @unique
  name                String
  homeUrl             String
  domain              String                     @unique
  description         String
  logoUrl             String?
  searchKind          DatasetProviderSearchKind?
  searchEndpoint      String?
  searchQueryTemplate String?
  datasetUrlTemplate  String?
  agentInstructions   String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  datasets DatasetEntry[]
  topics   DatasetTopic[]

  @@index([domain])
}

model DatasetEntry {
  id          String   @id @default(cuid())
  name        String
  shortName   String?
  url         String
  domain      String
  description String
  keywords    String[] @default([])
  sourcePaperId String?
  sourceRank    Float?
  addedBy       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerId String?
  provider   DatasetProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  topics     DatasetTopic[]

  @@index([domain])
  @@index([sourceRank(sort: Desc)])
  @@index([providerId])
}
